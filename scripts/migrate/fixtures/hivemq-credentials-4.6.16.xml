<!--
  FIXTURE PROVENANCE — read this before changing a line.

  Copied VERBATIM on 2026-08-14 from the vendor's documented "Example credentials.xml"
  in the File RBAC extension's README at tag 4.6.16 (published 2026-07-30):
    https://github.com/hivemq/hivemq-file-rbac-extension/blob/4.6.16/README.adoc
  fetched via the GitHub contents API. Only this header and the two <permission>
  blocks marked ADDED below were added; the users, the roles, the hashes and the
  vendor's own explanatory comments are unmodified.

  The two ADDED permissions exercise the qualifier gaps: mqttd's ACL rules carry no
  <qos> and no <shared-subscription> constraint, so both must come out as
  TODO(migrate) lines saying the emitted rule is BROADER than the original.

  The password hashes below are the vendor's own published example hashes (for the
  documented passwords "pass1" and "admin-password"). The converter never reads,
  copies or transforms them — it emits a re-enrolment command per username instead.

  NO LIVE HiveMQ BROKER WAS RUN to produce this file.
-->
<file-rbac>
    <users>
        <user>
            <name>user1</name>
            <!--- password hash for "pass1" -->
            <password>WFNQUVB0UkxjM04xa0hSR1BQNGhuOTJKVzdlbXA4bjk=:100:FY12nwpUEbBK9EKQ/Aw/rQKSoA7jXsC0HKELwU2mLCVU39bJVK0zf4NemuFeDOHPO4BW1nOjxi6NporkC6rUog==</password>
            <roles>
                <id>role1</id>
            </roles>
        </user>
        <user>
            <name>admin-user</name>
            <!-- password hash for "admin-password" -->
            <password>Vjc1a0lxQ3Nvb0ljNFVHNE9WRnM3RG1IZmdNUFcwVGY=:100:PL2FLqfpdhONG7qXjAMmdVn4wlMiXnypdXiFW09zqorFhKgoiixFQw2EVJJfE9Zn79q45V7Xpc6JeKLp0ntmYA==</password>
            <roles>
                <id>role1</id>
                <id>superuser</id>
            </roles>
        </user>
    </users>
    <roles>
        <role>
            <id>role1</id>
            <permissions>
                <permission>
                    <!-- PUBLISH and SUBSCRIBE to all topics below "data/<clientid>/" -->
                    <topic>data/${{clientid}}/#</topic>
                </permission>
                <permission>
                    <!-- PUBLISH to topic "outgoing/<clientid>", retained only-->
                    <topic>outgoing/${{clientid}}</topic>
                    <activity>PUBLISH</activity>
                    <retain>RETAINED</retain>
                </permission>
                <permission>
                    <!-- SUBSCRIBE to topic "incoming/<username>"-->
                    <topic>incoming/${{username}}/actions</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
                <!-- ADDED for this fixture: a QoS-qualified permission. -->
                <permission>
                    <topic>bulk/${{username}}/#</topic>
                    <activity>PUBLISH</activity>
                    <qos>ZERO</qos>
                </permission>
                <!-- ADDED for this fixture: a shared-subscription-scoped permission. -->
                <permission>
                    <topic>work/queue</topic>
                    <activity>SUBSCRIBE</activity>
                    <shared-subscription>SHARED</shared-subscription>
                    <shared-group>workers</shared-group>
                </permission>
            </permissions>
        </role>
        <role>
            <id>superuser</id>
            <permissions>
                <permission>
                    <!-- Allow everything -->
                    <topic>#</topic>
                </permission>
            </permissions>
        </role>
    </roles>
</file-rbac>
