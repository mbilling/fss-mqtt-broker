# /etc/mqttd/mqttd.env — one per host. Copy, edit the five marked lines, done.
#
# This is the same configuration deploy/compose/compose.yaml expresses; only the
# packaging differs. Every setting is documented in the README's environment tables.
#
# Install:
#   install -m 0640 -o root -g mqttd mqttd.env.example /etc/mqttd/mqttd.env
# The file holds no secrets (they are referenced by path), but the seed list and
# topology are still not world-readable.

# ── 1. IDENTITY — different on every node ─────────────────────────────────────────
MQTTD_NODE_ID=mqttd-1
# What PEERS dial to reach this node. Must be an address they can route to: a hostname
# or the host's real IP, never 0.0.0.0 and never 127.0.0.1 on a multi-host cluster.
MQTTD_PEER_ADVERTISE=mqttd-1.internal.example.com:7001

# ── 2. SEEDS — different on every node ────────────────────────────────────────────
# Gossip contact points used to JOIN. Outside Kubernetes this list is YOURS to maintain
# (docs/OPERATIONS.md): nothing rewrites it at runtime, and a node whose every seed has
# been decommissioned will retry forever without joining.
#
# EXACTLY ONE node bootstraps the cluster with an EMPTY seed list — that is what makes it
# found the lease group. On every other node, name two others so one node's outage does
# not block a rejoin.
#
#   node 1 (founder, first boot only):  MQTTD_SWIM_SEEDS=
#   node 2:                             MQTTD_SWIM_SEEDS=mqttd-1...:7946,mqttd-3...:7946
#   node 3:                             MQTTD_SWIM_SEEDS=mqttd-1...:7946,mqttd-2...:7946
#
# AFTER the cluster is formed, give node 1 seeds too and reload. A seedless node that
# comes back with an empty data directory founds a SECOND cluster; with seeds it rejoins.
# (The broker contains that itself — a re-founder hears the survivors and self-quarantines,
# ADR 0054 — but you want it to not happen, not to be contained.)
MQTTD_SWIM_SEEDS=

# ── 3. READINESS FLOOR — set to a majority of your node count ─────────────────────
# 2 for a 3-node cluster, 3 for 5. A node that cannot see this many members reports
# NOT ready and should be pulled from your load balancer.
# EXCEPTION: the founder needs 1 on its very first boot, or it can never come up alone.
MQTTD_READY_MIN_MEMBERS=2

# ── 4. SECRETS — by path, never inline ────────────────────────────────────────────
# Generate with: printf %s '<password>' | mqttd --hash-password <username> >> /etc/mqttd/passwd
MQTTD_PASSWORD_FILE=/etc/mqttd/passwd
MQTTD_ACL_FILE=/etc/mqttd/acl.toml
# The gossip mesh is authenticated (ADR 0003). ONE KEY FOR THE WHOLE CLUSTER — generate it
# ONCE and copy it to every node; anything that can reach the gossip port without it cannot
# join, and a node with a DIFFERENT key cannot join either. Three hosts that each run
# `openssl rand` get three keys and no mesh: all three start, log "SWIM gossip is SIGNED
# per-node", and never become ready — the same symptom as a per-host CA, with nothing
# naming the cause.
#   # once, on ONE host (or your admin box):
#   openssl rand -hex 32 > swim.key && chmod 0600 swim.key
#   # then, for EVERY host including that one:
#   scp -p swim.key <host>:/tmp/swim.key
#   ssh <host> 'sudo install -m 0640 -o root -g mqttd /tmp/swim.key /etc/mqttd/swim.key \
#               && rm -f /tmp/swim.key'
MQTTD_SWIM_KEY_FILE=/etc/mqttd/swim.key

# ── 5. TLS — mint the material, then this node serves TLS 1.3 and nothing else ────
# These are UNCOMMENTED on purpose: an unedited copy of this file fails CLOSED at startup,
# naming the setting and the path it could not read, rather than quietly serving cleartext
# on 1883. On a host with no certificates the broker refuses to start with:
#
#   Error: "cannot read MQTTD_PEER_TLS_CA (/etc/mqttd/tls/peer-ca.pem): No such file or directory (os error 2)"
#
# (the cluster bus is built before the client listener, so its CA is the first thing missing;
# with the bus material in place the next refusal names MQTTD_TLS_CERT the same way).
# Mint everything below with ./gen-certs.sh — see the recipe under the cluster-bus block.
# TLS 1.3 only, by design.
MQTTD_TLS_BIND=0.0.0.0:8883
MQTTD_TLS_CERT=/etc/mqttd/tls/server.pem
MQTTD_TLS_KEY=/etc/mqttd/tls/server.key
# For client mTLS, add the client CA — then the identity is the certificate's CN.
#
# THE CLIENT CA MUST NOT BE THE CLUSTER-BUS CA (MQTTD_PEER_TLS_CA below), and the two files
# named here are YOURS TO PROVIDE: nothing in this repository mints them — ./gen-certs.sh
# produces peer-ca.pem, peer.pem/key and server.pem/key, and no client CA at all.
# Why they must be different CAs: the cluster bus trusts every leaf issued by its CA as a
# mesh member. Such a peer can send a ProxyHello and be served as any MQTT identity it
# names ("the sender is a verified mesh member" — crates/mqttd/src/peer.rs), and a Hello
# whose CN equals a node id joins the mesh as that node. So pointing this at peer-ca.pem
# would turn every device certificate into a cluster credential — strictly LESS security
# than the password file it was meant to strengthen.
# Uncommenting it before you have put that file on the host is a startup error, not a
# fallback to some other CA:
#   Error: "cannot read MQTTD_TLS_CLIENT_CA (/etc/mqttd/tls/client-ca.pem): No such file or directory (os error 2)"
#MQTTD_TLS_CLIENT_CA=/etc/mqttd/tls/client-ca.pem   # your CLIENT CA — never peer-ca.pem
#MQTTD_TLS_CRL=/etc/mqttd/tls/client-crl.pem        # your client CRL, if you issue one

# ── The cluster bus is mutually authenticated ─────────────────────────────────────
# Without these the peer bus is PLAINTEXT: anything on the network that can reach :7001
# can speak to it, and the broker logs "INSECURE: starting PLAINTEXT peer listener".
# A partially-set trio is a startup error, by design — there is no half-authenticated bus.
MQTTD_PEER_TLS_CA=/etc/mqttd/tls/peer-ca.pem
MQTTD_PEER_TLS_CERT=/etc/mqttd/tls/peer.pem
MQTTD_PEER_TLS_KEY=/etc/mqttd/tls/peer.key
#MQTTD_PEER_TLS_CRL=/etc/mqttd/tls/peer-crl.pem
#
# FOUR RULES the PEER certificate must satisfy. Each of them is easy to get wrong exactly
# once, and three of the four fail at runtime rather than at issue time:
#   1. its Subject CN MUST equal this node's MQTTD_NODE_ID. A peer may only claim the node id
#      its certificate attests to; a mismatch drops the link with "peer Hello node id does
#      not match its certificate Common Name".
#   2. its SAN MUST cover the HOST PART of this node's MQTTD_PEER_ADVERTISE, because that is
#      the name a dialing peer verifies against.
#   3. it needs BOTH serverAuth and clientAuth: every node dials and is dialed, and a client
#      certificate without clientAuth is rejected at the handshake.
#   4. its KEY must be ECDSA P-256/P-384 or Ed25519, NOT RSA — this key is also the per-node
#      gossip signing key (see the consequence below) and that signer accepts nothing else.
#      An RSA leaf gives you a working TLS handshake and then a hard startup failure reading
#      "unsupported or unparseable gossip signing key".
#
# MINT IT WITH ./gen-certs.sh — a real script in this directory, not a comment. It satisfies
# all four rules, and scripts/deploy-smoke.sh boots two real nodes from its output on every
# CI run, so it cannot rot the way a pasted recipe does:
#
#   ./gen-certs.sh ca                                  # ONCE for the CLUSTER, on your admin box
#   ./gen-certs.sh node mqttd-1 mqttd-1.internal.example.com mqtt.example.com
#
# ONE CA FOR THE WHOLE CLUSTER, not one per host. Three hosts that each self-sign their own
# CA get three mutually-untrusting trust roots: every peer mTLS handshake fails, per-node
# gossip verification fails with it, membership never forms, and all three brokers start,
# log "SIGNED per-node" and never become ready — with nothing naming the cause. So run
# `ca` once, then copy only peer-ca.pem (plus that node's peer/server leaves) to each host.
#
# THE CA PRIVATE KEY MUST NOT LIVE ON A BROKER HOST. gen-certs.sh keeps it in its own
# directory on the machine you ran it on and never lists it among the files to copy: anything
# that can read it can mint a leaf with any CN, and rule 1 means such a leaf can claim any
# node's identity and forge that node's gossip signatures. For the same reason there is no
# `chmod /etc/mqttd/tls/*.key` step anywhere — a glob would hand every key in that directory
# to the mqttd group. Install each file with its own mode; gen-certs.sh prints the commands.
#
# (deploy/compose/init.sh does the equivalent for three nodes inside one container, if you
# would rather read the compose packaging's version.)
#
# CONSEQUENCE, stated so it is not a surprise: with the gossip key AND this material
# present, gossip becomes per-node SIGNED (ADR 0022, MQTTD_SWIM_SIGNED defaults to
# `require`) and each broker logs "SWIM gossip is SIGNED per-node".
#
# There is no rolling upgrade from a plaintext cluster to this one. Neither half has a mixed
# mode: signed gossip has none, and the peer bus has none either — a node with peer-TLS
# material accepts only mTLS links (there is no sniffing and no plaintext fallback), so a
# rolled node can form no bus link with an un-rolled one whatever MQTTD_SWIM_SIGNED says.
# Mid-roll you have two halves that cannot replicate or route to each other, and the minority
# half loses lease-group readiness. Restart the whole cluster instead; the data directories
# hold the durable state, so that is downtime, not data loss.

# ── The rest is identical on every node ───────────────────────────────────────────
MQTTD_DATA_DIR=/var/lib/mqttd
MQTTD_HEALTH_BIND=127.0.0.1:8080
MQTTD_PEER_BIND=0.0.0.0:7001
MQTTD_SWIM_BIND=0.0.0.0:7946
MQTTD_SHUTDOWN_GRACE=30
RUST_LOG=info

# INSECURE, opt-in: a plaintext MQTT listener. Credentials cross the wire in cleartext —
# the password file is Argon2id-hashed at rest, but the passwords themselves are not
# protected in flight — and the broker logs "INSECURE: starting PLAINTEXT MQTT listener"
# on every start. Uncomment it only for a trusted network, and keep the TLS listener above:
# this ADDS a way in, it does not replace one.
#MQTTD_PLAINTEXT_BIND=0.0.0.0:1883

# ── Bounds (docs/SIZING.md) ───────────────────────────────────────────────────────
# The unit already caps memory with MemoryMax. These cap the state that fills it.
#MQTTD_MAX_CONNECTIONS=10000
#MQTTD_MAX_SESSIONS=50000
#MQTTD_MAX_QUEUED_MESSAGES=1000
#MQTTD_MAX_RETAINED_MESSAGES=100000
#MQTTD_STORE_MAX_BYTES=16000000000
