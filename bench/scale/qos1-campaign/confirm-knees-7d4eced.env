# Confirm the known QoS 1 knees on the release: v1.2.0 commit (7d4eced), ONE provisioning.
# Shape = qos1-campaign/knee-n10.env: a site is 3,000 publishers x 10 msg/s =
# 30,000 msg/s, 20 clean-session consumers.
#   10 nodes: 13 sites = 39k/node (certified), 14 = 42k, 15 = 45k on v1.0.18.
#   3 nodes:  4 sites = 40k/node (certified on v1.0.17), 5 sites probes above it.
# Closing 10-node arm at 13 sites is the drift control.
# Result: ../qos1-knees-2026-10-12.md. Driver: 482-per-node-knee.sh.
#
# The binary is an UNRELEASED candidate: the release commit cross-built by hand
# (zig cc, x86_64 musl, not stripped, without the jq module), not the release
# pipeline's signed build. The run is stamped UNRELEASED-BINARY.txt.
export MQTTD_VERSION=main-7d4eced
export MQTTD_URL=https://github.com/mbilling/fss-mqtt-broker/releases/download/bench-candidate-7d4eced/mqttd-x86_64-unknown-linux-musl
export MQTTD_SHA256=9111c1eb96054ffc04981b8e1e4d6e3441f75c2dc341e3fe4fd8dda066ecc513
export BENCH_GIT_REF=7d4eced
export LANES=E CLOUD=hcloud
export BROKER_TYPE=ccx23 DRIVER_TYPE=ccx33 DRIVER_COUNT=20
export TF_VAR_build_bench=false
export LANE_E_QOS=1 LANE_E_SUB_QOS=1
export LANE_E_PUBS_PER_SITE=3000 LANE_E_SUBS_PER_SITE=20
export LANE_E_SUB_CONTAINERS_PER_SITE=2 LANE_E_PUB_CONTAINERS_PER_SITE=4
export LANE_E_PLACEMENT=container LANE_E_PIN_SITES=0
export LANE_E_SECS=60 LANE_E_CONTROL=1
export LANE_E_FORWARD_CANARY=1 LANE_E_CALIBRATE=0
export LANE_E_STOP_AFTER_FAILS=2
export KNEE_ARMS="10:20:1 13 14 15; 3:8:1 4 4 5; 10:20:1 13"
export OBSERVE=1 KEEP_INFRA=0
# The audit driver is pinned in the shell, by absolute path (not committed here):
#   export QOS1_DRIVER_ARCHIVE=<emqtt-bench 0.6.3 + audit extension from qos1-driver/, built for linux/amd64; the run used archive sha256 2cded28d..., image sha256:1194c6b2...>
