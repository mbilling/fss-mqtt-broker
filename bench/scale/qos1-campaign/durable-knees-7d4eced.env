# Durable QoS 1 (PERSISTENT consumers: every delivery waits for fsync + quorum) on the
# release: v1.2.0 commit (7d4eced), ONE provisioning. Shape = qos1-campaign/durable-3-5-7-10.env:
# a site is 600 publishers x 10 msg/s x 200 B = 6,000 msg/s, 20 persistent consumers.
#   3 nodes: GREEN through 15 sites (30k/node), 18 marginal, on 2026-09-30 (0080-replicas-ab-n3.md);
#            disk luck moved the knee 13 -> 16 sites between provisionings (2026-10-03).
#   10 nodes: no recorded durable knee; ladder at 15k, 21k, 24k, 30k per node.
# Closing 10-node arm at 25 sites is the drift control.
# Result: ../durable-knees-2026-10-12.md. Driver: 482-per-node-knee.sh.
#
# MQTTD_REPLICA_STORE and MQTTD_REPLICAS are deliberately unset: the DEFAULT store
# (redb) at the default 2 copies. The 2026-09-30 figures quoted above used
# MQTTD_REPLICA_STORE=log, so the 3-node ladder below starts above this store's
# ceiling — see the card.
#
# The binary is an UNRELEASED candidate: the release commit cross-built by hand
# (zig cc, x86_64 musl, not stripped, without the jq module), not the release
# pipeline's signed build. The run is stamped UNRELEASED-BINARY.txt.
export MQTTD_VERSION=main-7d4eced
export MQTTD_URL=https://github.com/mbilling/fss-mqtt-broker/releases/download/bench-candidate-7d4eced/mqttd-x86_64-unknown-linux-musl
export MQTTD_SHA256=9111c1eb96054ffc04981b8e1e4d6e3441f75c2dc341e3fe4fd8dda066ecc513
export BENCH_GIT_REF=7d4eced
export LANES=E CLOUD=hcloud
export BROKER_TYPE=ccx23 DRIVER_TYPE=ccx33 DRIVER_COUNT=20
export TF_VAR_build_bench=false
export LANE_E_QOS=1 LANE_E_SUB_QOS=1
export LANE_E_SESSION_EXPIRY=30
export LANE_E_SITE_RATE=6000 LANE_E_PUBS_PER_SITE=600 LANE_E_SUBS_PER_SITE=20
export LANE_E_SUB_CONTAINERS_PER_SITE=2 LANE_E_PUB_CONTAINERS_PER_SITE=1
export LANE_E_PLACEMENT=container LANE_E_PIN_SITES=0
export LANE_E_PAYLOAD=200
export LANE_E_SECS=60 LANE_E_CONTROL=1
export LANE_E_FORWARD_CANARY=1 LANE_E_CALIBRATE=0
export LANE_E_STOP_AFTER_FAILS=2
export KNEE_ARMS="10:20:1 25 35 40 50; 3:8:1 12 15 18; 10:20:1 25"
export OBSERVE=1 KEEP_INFRA=0
# The audit driver is pinned in the shell, by absolute path (not committed here):
#   export QOS1_DRIVER_ARCHIVE=<emqtt-bench 0.6.3 + audit extension from qos1-driver/, built for linux/amd64; the run used archive sha256 2cded28d..., image sha256:1194c6b2...>
