# Durable QoS 1 (PERSISTENT consumers: every delivery waits for fsync + quorum) on the
# 1.2.0 release candidate (main ec407218), ONE provisioning, with a same-hosts arm on the
# 2026-10-12 build (7d4eced). Shape = durable-knees-7d4eced.env: a site is 600 publishers
# x 10 msg/s x 200 B = 6,000 msg/s into 20 persistent consumers (session expiry 30 s).
#   10 nodes, 2026-10-12: 25 sites (15k/node) taken in full; ceiling ~19-21k/node (35 sites).
#   3 nodes, 2026-10-12: ceiling 20.7-20.9k/node; that ladder started above it (12 sites =
#   24k/node), so this one runs 8 / 10 / 12 sites (16k / 20k / 24k per node).
# Arm 3 swaps every broker to 7d4eced (RIG_BINARY=alt) at 25 and 35 sites: same hosts,
# the earlier build. Arms 4 and 5 run the experimental log store (MQTTD_REPLICA_STORE=log)
# on the candidate: 10 nodes at 35 / 45 / 50 sites (21k / 27k / 30k per node), 3 nodes at
# 12 / 15 / 18 (24k / 30k / 36k; 15 was GREEN on 2026-09-30). Arm 6, redb on ec407218,
# is the drift control. Arms 1-3 and 6: the default store (redb); all arms default 2 copies.
# Result: ../durable-knees-2026-10-21.md. Driver: ../482-per-node-knee.sh.
#
# The binary is an UNRELEASED candidate (bench-candidate-ec40721, built with the release
# recipe), not the signed release pipeline's build. Stamped UNRELEASED-BINARY.txt.
export MQTTD_VERSION=main-ec40721
export MQTTD_URL=https://github.com/mbilling/fss-mqtt-broker/releases/download/bench-candidate-ec40721/mqttd-x86_64-unknown-linux-musl
export MQTTD_SHA256=e3c3dcbfda83bb6ae46ffe533ff7d60038ea4d8661db86b306be9c8d3670e036
export ALT_MQTTD_URL=https://github.com/mbilling/fss-mqtt-broker/releases/download/bench-candidate-7d4eced/mqttd-x86_64-unknown-linux-musl
export ALT_MQTTD_SHA256=9111c1eb96054ffc04981b8e1e4d6e3441f75c2dc341e3fe4fd8dda066ecc513
export BENCH_GIT_REF=ec407218
export LANES=E CLOUD=hcloud
export BROKER_TYPE=ccx23 DRIVER_TYPE=ccx33 DRIVER_COUNT=20
export TF_VAR_build_bench=false
export LANE_E_QOS=1 LANE_E_SUB_QOS=1
export LANE_E_SESSION_EXPIRY=30
export LANE_E_SITE_RATE=6000 LANE_E_PUBS_PER_SITE=600 LANE_E_SUBS_PER_SITE=20
export LANE_E_SUB_CONTAINERS_PER_SITE=2 LANE_E_PUB_CONTAINERS_PER_SITE=1
export LANE_E_PLACEMENT=container LANE_E_PIN_SITES=0
export LANE_E_PAYLOAD=200
export LANE_E_SECS=60 LANE_E_CONTROL=1
export LANE_E_FORWARD_CANARY=1 LANE_E_CALIBRATE=0
export LANE_E_STOP_AFTER_FAILS=2
export KNEE_ARMS="10:20:1 25 35 40; 3:8:1 8 10 12; 10:20:1 25 35:RIG_BINARY=alt; 10:20:1 35 45 50:MQTTD_REPLICA_STORE=log; 3:8:1 12 15 18:MQTTD_REPLICA_STORE=log; 10:20:1 25 35"
export OBSERVE=1 KEEP_INFRA=0
# Audit driver, pinned in the shell (not committed): QOS1_DRIVER_ARCHIVE = emqtt-bench
# 0.6.3 + qos1-driver/, linux/amd64, archive sha256 d765e908..., image sha256:ab924082...
