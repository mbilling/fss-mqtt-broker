# Durable QoS 1 scale-out, 3 -> 10 nodes on ONE provisioning (#568).
# Driver: 482-per-node-knee.sh — the same method as the QoS 0 card
# (knee-3-5-7-10.env) and the QoS 1 curve, with PERSISTENT consumers, so every
# delivery waits for fsync + quorum. Run durable-calibrate-n3.env first.
#
# The question it answers: does durable throughput FOLLOW THE DISK? Each broker
# boot-probes its own volume (store_barrier_floor), and summarize-curve.py prints,
# per rung and per broker, the durable appends, group commits, ops per commit and
# how busy the writer was over the steady window. At the knee:
#   writers saturated, and per-node rate tracking each node's floor -> disk-bound;
#   writers with headroom                                          -> the hot path.
#
# Quota: 10 x CCX23 + 20 x CCX33 = 200 vCPU on 30 servers — the project limit.
# Pin the binary and the audited driver in the shell (not committed here):
#   export MQTTD_VERSION=1.0.18
#   export QOS1_DRIVER_ARCHIVE=<emqtt-bench 0.6.3 + audit extension, sha256 c42449e6...; it must hold the SAME image as the local fss-qos1-audit:local, or every driver fails "audit image mismatch" before a rung>
export MQTTD_VERSION="${MQTTD_VERSION:-1.0.18}"
export LANES=E CLOUD=hcloud
export BROKER_TYPE=ccx23 DRIVER_TYPE=ccx33 DRIVER_COUNT=20
export TF_VAR_build_bench=false
export LANE_E_QOS=1 LANE_E_SUB_QOS=1
export LANE_E_SESSION_EXPIRY=30
# The calibration's site: 600 publishers x 10 msg/s x 200 B = 6,000 msg/s, one
# publisher and two consumer containers (20 persistent consumers, covering every
# broker at every size, so crossing stays ~0%).
export LANE_E_SITE_RATE=6000 LANE_E_PUBS_PER_SITE=600 LANE_E_SUBS_PER_SITE=20
export LANE_E_SUB_CONTAINERS_PER_SITE=2 LANE_E_PUB_CONTAINERS_PER_SITE=1
export LANE_E_PLACEMENT=container LANE_E_PIN_SITES=0
export LANE_E_PAYLOAD=200
export LANE_E_SECS=60 LANE_E_CONTROL=1
export LANE_E_FORWARD_CANARY=1 LANE_E_CALIBRATE=0
export LANE_E_STOP_AFTER_FAILS=2
# Arms: <brokers>:<drivers>:<ladder>, drivers 2N as in the QoS 0 card; largest
# first, then down, then the largest again as the drift control. Ladders are
# matched in per-node offer, sites = per-node x N / 6,000:
#   per node   3k  6k  9k  12k 15k 18k 21k 24k 30k
#   N=10        5  10  15  20  25  30  35  40  50
#   N=7         4*  7  11* 14  18* 21  25* 28  35    (* nearest: 3.4 9.4 15.4 21.4k)
#   N=5         3*  5   8* 10  13* 15  18* 20  25    (* 3.6 9.6 15.6 21.6k)
#   N=3         2*  3   5*  6   8*  9  11* 12  15    (* 4 10 16 22k)
# At most 53 sites fit 20 drivers (3 containers per site, 160 vCPU), ~32k/node at
# 10 nodes. Set the ladder from the calibration's knee — the rungs around it, a
# repeat at the knee — rather than paying to climb a guessed one:
#   export KNEE_ARMS="10:20:1 ... ; 7:14:1 ... ; 5:10:1 ... ; 3:6:1 ... ; 10:20:1 <knee>"
export KNEE_ARMS="${KNEE_ARMS:?set KNEE_ARMS from the result of durable-calibrate-n3.env — see the table above}"
export OBSERVE=0
