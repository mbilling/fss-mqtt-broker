# Durable QoS 1 — R=3 against R=2 on ONE provisioning (ADR 0080 T6, #705).
# Driver: 482-per-node-knee.sh. Shape: durable-calibrate-n3.env, which it sources.
#
# Both factors run on the SAME three CCX23 brokers, each arm a fresh cluster on
# empty log stores founded at its own MQTTD_REPLICAS. The first attempt (nbg1,
# 2026-09-30) died mid-R=2 on a local network drop; the ladders are trimmed to
# where the answer lies (both GREEN through 6 sites there). At N=3, R=3 writes every message on
# all three nodes and R=2 on two, so R=2 should carry about 1.5x (R/N 3/3 to 2/3).
#
# Quota and ladder as the calibration: 3 x CCX23 + 8 x CCX33, sites x 2k msg/s
# per node. 21 sites is the fleet's honest ceiling (63 containers on 64 vCPU):
# an R=2 arm still GREEN there has its knee at or above 126,000 msg/s.
#   export MQTTD_VERSION=main-039232d
#   export MQTTD_URL=https://github.com/mbilling/fss-mqtt-broker/releases/download/bench-candidate-039232d/mqttd-x86_64-unknown-linux-musl
#   export MQTTD_SHA256=23962a4269aac0ea25537afa1f5185435ce19c6c2e6dfa7cf5b3500dfd8cf449
#   export QOS1_DRIVER_ARCHIVE=<emqtt-bench 0.6.3 + audit extension, sha256 c42449e6...>
#   set -a; . ./qos1-campaign/durable-replicas-ab-n3.env; set +a
. "$(dirname "${BASH_SOURCE[0]}")/durable-calibrate-n3.env"
export KNEE_ARMS="3:8:1 12 15 18:MQTTD_REPLICA_STORE=log,MQTTD_REPLICAS=3; 3:8:1 12 15 18 21:MQTTD_REPLICA_STORE=log,MQTTD_REPLICAS=2"
export OBSERVE=0 KEEP_INFRA=0
