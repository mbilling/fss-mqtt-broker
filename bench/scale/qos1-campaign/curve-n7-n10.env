# QoS 1 curve points at 7 and 10 nodes, on ONE provisioning — see
# docs/benchmarks/QOS1-SCALE-CURVE.md. Driver: 482-per-node-knee.sh (arms).
# The site shape is the published curve's, unchanged: 3,000 publishers x 10 msg/s
# x 200 B = 30,000 msg/s per site, QoS 1 both ways, one $share group, four
# publisher and two consumer containers per site, fixed allocation — except the
# consumer count (below).
# Quota: 10 x CCX23 + 20 x CCX33 = 200 vCPU on 30 servers.
# Pin the binary and the audited driver in the shell (not committed here):
#   export MQTTD_VERSION=main-0a08187 MQTTD_URL=... MQTTD_SHA256=... BENCH_GIT_REF=0a08187
#   export QOS1_DRIVER_ARCHIVE=<emqtt-bench 0.6.3 + audit extension, sha256 67bb4194...>
export LANES=E CLOUD=hcloud
export BROKER_TYPE=ccx23 DRIVER_TYPE=ccx33 DRIVER_COUNT=20
export TF_VAR_build_bench=false
export LANE_E_QOS=1 LANE_E_SUB_QOS=1
# 20 consumers, not the published 10: one container of K consumers covers K
# brokers, so 10 in 2 containers cover 6 of 10 (and 6 of 7) and ~40% of publishes
# would forward — the gap 5b763e1 refuses. 20 in 2 containers cover 11 >= 10.
# Each container still receives 15,000/s, as before; at 10 nodes that is 2
# members per broker per site — what the published 5-node point had with 10.
export LANE_E_PUBS_PER_SITE=3000 LANE_E_SUBS_PER_SITE=20
export LANE_E_SUB_CONTAINERS_PER_SITE=2 LANE_E_PUB_CONTAINERS_PER_SITE=4
export LANE_E_PLACEMENT=container LANE_E_PIN_SITES=0
export LANE_E_SECS=60 LANE_E_CONTROL=1
export LANE_E_FORWARD_CANARY=1 LANE_E_CALIBRATE=0
export LANE_E_STOP_AFTER_FAILS=2
# Both sizes use all 20 drivers (the most headroom the quota allows). The
# qualified rung is repeated three times at a matched ~39k msg/s per node — the
# 3- and 5-node points sit at 40k and 36k — with one probe above it:
#   N=10: 13 sites = 390 000/s = 39.0k/node (x3), probe 14 = 42.0k/node
#   N=7:   9 sites = 270 000/s = 38.6k/node (x3), probe 10 = 42.9k/node
# The pending-publish cap that bounded 5 nodes at 204,800/s (#633) is lifted in
# this candidate (65,536 entries, bounded by bytes).
export KNEE_ARMS="10:20:1 2 4 8 10 12 13 13 13 14; 7:20:1 2 4 6 8 9 9 9 10; 10:20:1 12"
export OBSERVE=0 KEEP_INFRA=0
