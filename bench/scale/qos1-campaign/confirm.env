# One provisioning only. Up/down load sweep, repeated 120k, five-minute hold.
export MQTTD_VERSION=1.0.17 LANES=E CLOUD=hcloud
export BROKER_TYPE=ccx23 DRIVER_TYPE=ccx33 DRIVER_COUNT=5
export TF_VAR_build_bench=false
export LANE_E_QOS=1 LANE_E_SUB_QOS=1
export LANE_E_PUBS_PER_SITE=3000 LANE_E_SUBS_PER_SITE=10
export LANE_E_SITES_OVERRIDE="1 2 3 4 3 2 1 4"
export LANE_E_SECS=60 LANE_E_HOLD_LAST_SECS=300
export LANE_E_CONTROL=1 LANE_E_FORWARD_CANARY=1 LANE_E_CALIBRATE=0
export LANE_E_PIN_SITES=0 OBSERVE=0
export KEEP_INFRA=0
