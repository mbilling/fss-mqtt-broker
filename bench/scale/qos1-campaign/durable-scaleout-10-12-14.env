# Durable QoS 1 scale-out at 10, 12 and 14 nodes on ONE provisioning.
# Card: ../durable-scaleout-10-12-14.md. Driver: ../482-per-node-knee.sh.
# A DIAGNOSTIC scale-out, read by a simple rule (no loss, p99 < 1 s) — not a
# certified curve. Do NOT export HCLOUD_TOKEN in a committed file.
#
# Shape = durable-knees-7d4eced.env: a site is 600 publishers x 10 msg/s x 200 B
# = 6,000 msg/s — but 28 PERSISTENT consumers, not 20 (every delivery waits for fsync
# + quorum). Two containers of 10 reach 11 brokers, which covered 10 nodes and leaves
# 3 of 14 without a local member; the shape check refuses that. 14 per container
# reaches every broker at every size here.
# MQTTD_REPLICA_STORE and MQTTD_REPLICAS are unset: the default store at 2 copies.
#
# Quota: 14 x CCX23 + 16 x CCX33 = 56 + 128 = 184 vCPU on 30 servers; the project
# allows 200 vCPU / 30 servers. The server count is exactly at its limit: there is
# no room for a 17th driver, and replace-node.sh swaps a bad host in place
# (delete, then create), so a swap does not need a 31st.
#
# Brokers 11-14 sit in a SECOND spread placement group (terraform/layout.tf): they
# may share a physical host with a broker of the first ten.
#
# The binary is pinned in the shell, never here:
#   export MQTTD_VERSION=<release>          # or, for a candidate:
#   export MQTTD_VERSION=main-<sha> MQTTD_URL=<url> MQTTD_SHA256=<sha256> BENCH_GIT_REF=<sha>
#   export QOS1_DRIVER_ARCHIVE=<absolute path to the audit driver archive built from qos1-driver/>
export LANES=E CLOUD=hcloud
export BROKER_TYPE=ccx23 DRIVER_TYPE=ccx33 DRIVER_COUNT=16
export TF_VAR_build_bench=false
export LANE_E_QOS=1 LANE_E_SUB_QOS=1
export LANE_E_SESSION_EXPIRY=30
export LANE_E_SITE_RATE=6000 LANE_E_PUBS_PER_SITE=600 LANE_E_SUBS_PER_SITE=28
export LANE_E_SUB_CONTAINERS_PER_SITE=2 LANE_E_PUB_CONTAINERS_PER_SITE=1
export LANE_E_PLACEMENT=container LANE_E_PIN_SITES=0
export LANE_E_PAYLOAD=200
export LANE_E_SECS=60 LANE_E_CONTROL=1
export LANE_E_FORWARD_CANARY=1 LANE_E_CALIBRATE=0
# The canary's deadline bounds the whole control, and its pairs grow as N x (N-1):
# 90 at 10 nodes, 182 at 14 (18,200 QoS 1 messages). Twice the pairs, twice the 90 s
# default; a control that times out stops the size on 30 billed servers.
export LANE_E_FORWARD_CANARY_TIMEOUT=180
export LANE_E_STOP_AFTER_FAILS=2
# Arms: <brokers>:<drivers>:<ladder>, largest first, resized down on the same
# hosts (the highest-numbered brokers are the ones left out), then the largest
# again as the drift control. Every arm keeps all 16 drivers.
#   per node    15k  18k
#   N=14         35   42     (210k, 252k msg/s)
#   N=12         30   36     (180k, 216k)
#   N=10         25   30     (150k, 180k)
# 42 sites is 126 one-vCPU containers on the 128 the 16 drivers have: fully packed.
export KNEE_ARMS="14:16:1 35 42; 12:16:1 30 36; 10:16:1 25 30; 14:16:1 35"
export OBSERVE=1
