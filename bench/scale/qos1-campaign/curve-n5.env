# Five-node QoS 1 curve point — see docs/benchmarks/QOS1-SCALE-CURVE.md
# Five-node QoS 1 point, at the allocation the 3-node calibration qualified.
# FIXED allocation (no LANE_E_PUB_CONTAINER_STEPS): varying it is what makes a
# provisioning "calibration only" and unusable as a capacity point.
export MQTTD_VERSION=1.0.17 LANES=E CLOUD=hcloud
export QOS1_SIZES=5
export BROKER_TYPE=ccx23 DRIVER_TYPE=ccx33 DRIVER_COUNT=12
export TF_VAR_build_bench=false
export LANE_E_QOS=1 LANE_E_SUB_QOS=1
export LANE_E_PUBS_PER_SITE=3000 LANE_E_SUBS_PER_SITE=10
export LANE_E_SUB_CONTAINERS_PER_SITE=2 LANE_E_PUB_CONTAINERS_PER_SITE=4
# 6 sites = 180,000 msg/s = 36,000/node, 90% of the 3-node result scaled linearly.
# Three repetitions at the top, plus the closing control, is what a qualified
# point needs. 8 sites would put 4,800 gated publishes on each broker against
# PENDING_PUBLISH_CAP=4096 (1.0.17) — out of reach until #635 ships.
export LANE_E_SITES_OVERRIDE="1 2 4 6 6 6"
export LANE_E_PLACEMENT=container LANE_E_PIN_SITES=0
export LANE_E_SECS=60 LANE_E_CONTROL=1
export LANE_E_FORWARD_CANARY=1 LANE_E_CALIBRATE=0
export OBSERVE=0 KEEP_INFRA=0
