# Durable QoS 1 — calibration on 3 nodes (#568). Driver: 482-per-node-knee.sh.
#
# The QoS 1 curve (QOS1-SCALE-CURVE.md) ran on durable-bootstrapped clusters with
# CLEAN consumers, so it measured the routing path: its durable-append count was 0
# on every rung. LANE_E_SESSION_EXPIRY makes the consumers persistent, which is
# what puts every delivery on fsync + quorum. Nothing has measured that on this
# hardware since pipelined appends (ADR 0075, in v1.0.18): the only figures are
# ~26k msg/s on one dev host and ~3k/node on v1.0.5 hardware. This run finds the
# range cheaply so the 3 -> 10 campaign (durable-3-5-7-10.env) can be laddered
# around it instead of guessed.
#
# Quota: 3 x CCX23 + 8 x CCX33 = 12 + 64 = 76 vCPU on 11 servers.
# Pin the binary and the audited driver in the shell (not committed here):
#   export MQTTD_VERSION=1.0.18
#   export QOS1_DRIVER_ARCHIVE=<emqtt-bench 0.6.3 + audit extension, sha256 c42449e6...; it must hold the SAME image as the local fss-qos1-audit:local, or every driver fails "audit image mismatch" before a rung>
export MQTTD_VERSION="${MQTTD_VERSION:-1.0.18}"
export LANES=E CLOUD=hcloud
export BROKER_TYPE=ccx23 DRIVER_TYPE=ccx33 DRIVER_COUNT=8
export TF_VAR_build_bench=false
export LANE_E_QOS=1 LANE_E_SUB_QOS=1
# Persistent consumers: clean_start=false, 30 s session expiry, per-rung client ids.
export LANE_E_SESSION_EXPIRY=30
# A 6,000 msg/s site (600 publishers x 10 msg/s x 200 B), a fifth of the QoS 1
# curve's, so a rung steps in 2k msg/s per node at 3 nodes. 20 consumers in 2
# containers cover every broker (C + K - 1 >= N), so crossing stays ~0% and each
# persistent consumer owes 300 msg/s — far inside one session lane's pipeline.
# One publisher container per site (600 clients, 6k msg/s — the QoS 1 curve ran
# 750 per container at 7.5k), so a site is 3 containers on 3 driver vCPUs.
export LANE_E_SITE_RATE=6000 LANE_E_PUBS_PER_SITE=600 LANE_E_SUBS_PER_SITE=20
export LANE_E_SUB_CONTAINERS_PER_SITE=2 LANE_E_PUB_CONTAINERS_PER_SITE=1
export LANE_E_PLACEMENT=container LANE_E_PIN_SITES=0
export LANE_E_PAYLOAD=200
export LANE_E_SECS=60 LANE_E_CONTROL=1
export LANE_E_FORWARD_CANARY=1 LANE_E_CALIBRATE=0
export LANE_E_STOP_AFTER_FAILS=2
# Per node = 2,000 msg/s per site at 3 nodes. Coarse, so the plausible range is
# covered in few rungs; the ladder stops 2 rungs past the knee:
#   sites  1   3   6   9   12   15   21
#   /node  2k  6k  12k 18k 24k  30k  42k
# 21 sites is 63 containers on 8 drivers x 8 vCPU — the most this fleet offers
# honestly. A durable knee above 42k/node is recorded as a floor.
# The closing arm re-runs 6 sites (12k/node) on the same hosts as the drift control.
export KNEE_ARMS="3:8:1 3 6 9 12 15 21; 3:8:1 6"
export OBSERVE=0 KEEP_INFRA=0
