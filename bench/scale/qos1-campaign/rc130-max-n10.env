# The 1.3.0 release-candidate configuration at 10 nodes, maximum capacity (#1083): durable
# QoS 1, 2 copies, the segment log store (MQTTD_REPLICA_STORE=log), write elision at 50 ms
# (MQTTD_DURABLE_WRITE_ELISION_MS=50), $share prefer-local on (the default), ONE
# provisioning. Shape = durable-knees-ec40721.env: a site is 600 publishers x 10 msg/s x
# 200 B = 6,000 msg/s into a $share group of 20 persistent consumers (session expiry 30 s).
#   2026-10-21, log store, no elision: 45 sites (27k/node) GREEN, 50 at 99.5% of offer.
# 20 x CCX33 drivers host 8 one-vCPU containers each, 3 per site: 53 sites (318,000 msg/s,
# 31.8k/node) is the most this fleet can offer. A 53-site rung that holds means "at least
# 318,000 msg/s, load-generator-limited", not a ceiling.
#   Arm 1: the 1.3.0 RC configuration, ladder 1 40 45 50 53.
#   Arm 2: the log store with elision off, same hosts: 1 45 50 (the gain from elision).
#   Arm 3: the 1.3.0 RC configuration again: 1 50 (drift control + repeat of the decisive rung).
# LANE_E_STOP_AFTER_FAILS=3 so the start-up overflow (#1078) cannot end a ladder alone.
# Result: ../rc130-max-n10-2026-10-23.md. Driver: ../482-per-node-knee.sh.
#
# The binary is an UNRELEASED candidate: main at ff3607daafd237fa71f950678494edebed9810f2
# (bench-candidate-ff3607d, the release recipe), with the 1.3.0 defaults set through the
# environment because the defaults change has not landed. Stamped UNRELEASED-BINARY.txt.
export MQTTD_VERSION=main-ff3607d
export MQTTD_URL=https://github.com/mbilling/fss-mqtt-broker/releases/download/bench-candidate-ff3607d/mqttd-x86_64-unknown-linux-musl
export MQTTD_SHA256=58d26b30f1aaf0b9be9f8d4d47d54bd115b091fee8925cbe6d4e9b84ba076722
export BENCH_GIT_REF=ff3607d
export LANES=E CLOUD=hcloud
export BROKER_TYPE=ccx23 DRIVER_TYPE=ccx33 DRIVER_COUNT=20
export TF_VAR_build_bench=false
export LANE_E_QOS=1 LANE_E_SUB_QOS=1
export LANE_E_SESSION_EXPIRY=30
export LANE_E_SITE_RATE=6000 LANE_E_PUBS_PER_SITE=600 LANE_E_SUBS_PER_SITE=20
export LANE_E_SUB_CONTAINERS_PER_SITE=2 LANE_E_PUB_CONTAINERS_PER_SITE=1
export LANE_E_PLACEMENT=container LANE_E_PIN_SITES=0
export LANE_E_PAYLOAD=200
export LANE_E_SECS=60 LANE_E_CONTROL=1
export LANE_E_FORWARD_CANARY=1 LANE_E_CALIBRATE=0
export LANE_E_STOP_AFTER_FAILS=3
export KNEE_ARMS="10:20:1 40 45 50 53:MQTTD_REPLICA_STORE=log,MQTTD_DURABLE_WRITE_ELISION_MS=50; 10:20:1 45 50:MQTTD_REPLICA_STORE=log,MQTTD_DURABLE_WRITE_ELISION_MS=0; 10:20:1 50:MQTTD_REPLICA_STORE=log,MQTTD_DURABLE_WRITE_ELISION_MS=50"
export OBSERVE=1 KEEP_INFRA=0
# Audit driver, pinned in the shell (not committed): QOS1_DRIVER_ARCHIVE = emqtt-bench
# 0.6.3 + qos1-driver/, linux/amd64, archive sha256 d765e908..., image sha256:ab924082...
