# ADR 0089 T5, first sweep: durable QoS 1 at 3 nodes, 2 copies (the default), with the
# write-elision window at 0 / 5 / 10 / 20 / 50 ms, ONE provisioning. Shape =
# durable-knees-ec40721.env: a site is 600 publishers x 10 msg/s x 200 B = 6,000 msg/s
# into a $share group of 20 persistent consumers (session expiry 30 s).
#   3 nodes, redb, elision off, 2026-10-21: 8 sites held (16k/node), 10 delivered 96.6%
#   of offer (19.3k/node); the knee.
# Every arm but 6 sets MQTTD_SHARED_PREFER_LOCAL=0, so a $share delivery goes to any
# member, not one on the publisher's node: the publish then crosses nodes before the
# subscriber's PUBACK can discharge it, and the window must cover that hop's answer too
# (the owner holds; the origin's PUBACK waits for the owner's Reached/Stored). On
# 2026-10-21 with prefer-local on, 3-node crossing was 0.00%.
#   Arm 1: window 0 (today's path), crossing forced. The baseline.
#   Arms 2-5: windows 5, 10, 20, 50 ms, crossing forced.
#   Arm 6: window 20 ms, prefer-local on (the default): the same-node contrast.
#   Arm 7: window 0, crossing forced again: the drift control.
# Read per broker: mqttd_publish_delivered_total (the rate), mqttd_durable_elided_total
# and mqttd_durable_elision_fallback_total{reason} (the share that skipped the write and
# why the rest did not), mqttd_durable_elision_hold_seconds (how close the subscribers'
# PUBACKs came to the window), mqttd_publish_forwarded_total (the crossing).
# Result: ../elision-window-n3-2026-10-21.md. Driver: ../482-per-node-knee.sh.
#
# The binary is an UNRELEASED candidate: branch adr-0089-t4 at fb90e03a (T1 + T2 + T4 on
# 1.2.0), built with the release recipe (scripts/release/build-repro.sh
# x86_64-unknown-linux-musl mqttd in an Ubuntu 24.04 amd64 container, Rust 1.97.0),
# published as the pre-release bench-candidate-fb90e03. Stamped UNRELEASED-BINARY.txt.
export MQTTD_VERSION=adr0089-fb90e03
export MQTTD_URL=https://github.com/mbilling/fss-mqtt-broker/releases/download/bench-candidate-fb90e03/mqttd-x86_64-unknown-linux-musl
export MQTTD_SHA256=6232dadcf2a00a3444377fe69d3aff03697ca4e337db3058b87ed5e6625bf58b
export BENCH_GIT_REF=ec407218
export LANES=E CLOUD=hcloud
export BROKER_TYPE=ccx23 DRIVER_TYPE=ccx33 DRIVER_COUNT=8
export TF_VAR_build_bench=false
export LANE_E_QOS=1 LANE_E_SUB_QOS=1
export LANE_E_SESSION_EXPIRY=30
export LANE_E_SITE_RATE=6000 LANE_E_PUBS_PER_SITE=600 LANE_E_SUBS_PER_SITE=20
export LANE_E_SUB_CONTAINERS_PER_SITE=2 LANE_E_PUB_CONTAINERS_PER_SITE=1
export LANE_E_PLACEMENT=container LANE_E_PIN_SITES=0
export LANE_E_PAYLOAD=200
export LANE_E_SECS=60 LANE_E_CONTROL=1
export LANE_E_FORWARD_CANARY=1 LANE_E_CALIBRATE=0
export LANE_E_STOP_AFTER_FAILS=2
export KNEE_ARMS="3:8:1 8 10:MQTTD_SHARED_PREFER_LOCAL=0,MQTTD_DURABLE_WRITE_ELISION_MS=0; 3:8:1 10 15 20:MQTTD_SHARED_PREFER_LOCAL=0,MQTTD_DURABLE_WRITE_ELISION_MS=5; 3:8:1 10 15 20:MQTTD_SHARED_PREFER_LOCAL=0,MQTTD_DURABLE_WRITE_ELISION_MS=10; 3:8:1 10 15 20:MQTTD_SHARED_PREFER_LOCAL=0,MQTTD_DURABLE_WRITE_ELISION_MS=20; 3:8:1 10 15 20:MQTTD_SHARED_PREFER_LOCAL=0,MQTTD_DURABLE_WRITE_ELISION_MS=50; 3:8:1 15 20:MQTTD_DURABLE_WRITE_ELISION_MS=20; 3:8:1 10:MQTTD_SHARED_PREFER_LOCAL=0,MQTTD_DURABLE_WRITE_ELISION_MS=0"
export OBSERVE=1 KEEP_INFRA=0
# Audit driver, pinned in the shell (not committed): QOS1_DRIVER_ARCHIVE = emqtt-bench
# 0.6.3 + qos1-driver/, linux/amd64, archive sha256 d765e908..., image sha256:ab924082...
