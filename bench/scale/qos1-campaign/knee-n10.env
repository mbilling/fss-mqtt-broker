# The QoS 1 knee at 10 nodes — see docs/benchmarks/QOS1-SCALE-CURVE.md.
# The 2026-09-26 7/10 campaign carried 390,000 msg/s (39k/node) at 10 nodes
# without a failing rung (its early stop misfired on evidence-only flags, since
# fixed). This climbs past it. Driver: 482-per-node-knee.sh.
# Same site shape and audited driver as curve-n7-n10.env; the released v1.0.18.
#   export QOS1_DRIVER_ARCHIVE=<emqtt-bench 0.6.3 + audit extension, sha256 67bb4194...>
export MQTTD_VERSION=1.0.18
export LANES=E CLOUD=hcloud
export BROKER_TYPE=ccx23 DRIVER_TYPE=ccx33 DRIVER_COUNT=20
export TF_VAR_build_bench=false
export LANE_E_QOS=1 LANE_E_SUB_QOS=1
export LANE_E_PUBS_PER_SITE=3000 LANE_E_SUBS_PER_SITE=20
export LANE_E_SUB_CONTAINERS_PER_SITE=2 LANE_E_PUB_CONTAINERS_PER_SITE=4
export LANE_E_PLACEMENT=container LANE_E_PIN_SITES=0
export LANE_E_SECS=60 LANE_E_CONTROL=1
export LANE_E_FORWARD_CANARY=1 LANE_E_CALIBRATE=0
export LANE_E_STOP_AFTER_FAILS=2
# Per node = 3,000 msg/s per site at 10 nodes:
#   12 = 36k · 13 = 39k (the prior point) · 14 = 42k · 15 = 45k · 16 = 48k · 17 = 51k
# Repeats at 42k and 45k, where 7 nodes turned (38.6k pass, 42.9k fail). The
# closing arm re-runs 39k on the same hosts as the drift control.
export KNEE_ARMS="10:20:1 4 8 12 13 14 14 15 15 16 17; 10:20:1 13"
export OBSERVE=0 KEEP_INFRA=0
