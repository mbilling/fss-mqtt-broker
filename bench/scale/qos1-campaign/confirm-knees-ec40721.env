# Confirm the QoS 1 knees on the 1.2.0 release candidate after #1052-#1060 (main ec407218),
# ONE provisioning, and compare it on the same hosts with the 2026-10-12 candidate (7d4eced).
# Shape = confirm-knees-7d4eced.env: a site is 3,000 publishers x 10 msg/s = 30,000 msg/s,
# 20 clean-session consumers.
#   10 nodes: 13 sites = 39k/node, 14 = 42k, 15 = 45k (7d4eced: 13 and 14 held).
#   3 nodes:  4 sites = 40k/node, 5 probes above it (7d4eced: both held, GREEN).
# Arm 3 swaps every broker to the 7d4eced candidate (RIG_BINARY=alt) at 13 sites: the
# same hosts, the earlier build. Arm 4, back on ec407218 at 13 sites, is the drift control.
# Driver: ../482-per-node-knee.sh.
#
# The binary is an UNRELEASED candidate: main ec407218 built with the release recipe
# (scripts/release/build-repro.sh x86_64-unknown-linux-musl mqttd in an Ubuntu 24.04
# amd64 container, Rust 1.97.0, musl-tools, stripped, jq module embedded), published as
# the pre-release bench-candidate-ec40721. Not the signed release pipeline's build. The
# run is stamped UNRELEASED-BINARY.txt.
export MQTTD_VERSION=main-ec40721
export MQTTD_URL=https://github.com/mbilling/fss-mqtt-broker/releases/download/bench-candidate-ec40721/mqttd-x86_64-unknown-linux-musl
export MQTTD_SHA256=e3c3dcbfda83bb6ae46ffe533ff7d60038ea4d8661db86b306be9c8d3670e036
export ALT_MQTTD_URL=https://github.com/mbilling/fss-mqtt-broker/releases/download/bench-candidate-7d4eced/mqttd-x86_64-unknown-linux-musl
export ALT_MQTTD_SHA256=9111c1eb96054ffc04981b8e1e4d6e3441f75c2dc341e3fe4fd8dda066ecc513
export BENCH_GIT_REF=ec407218
export LANES=E CLOUD=hcloud
export BROKER_TYPE=ccx23 DRIVER_TYPE=ccx33 DRIVER_COUNT=20
export TF_VAR_build_bench=false
export LANE_E_QOS=1 LANE_E_SUB_QOS=1
export LANE_E_PUBS_PER_SITE=3000 LANE_E_SUBS_PER_SITE=20
export LANE_E_SUB_CONTAINERS_PER_SITE=2 LANE_E_PUB_CONTAINERS_PER_SITE=4
export LANE_E_PLACEMENT=container LANE_E_PIN_SITES=0
export LANE_E_SECS=60 LANE_E_CONTROL=1
export LANE_E_FORWARD_CANARY=1 LANE_E_CALIBRATE=0
export LANE_E_STOP_AFTER_FAILS=2
export KNEE_ARMS="10:20:1 13 14 15; 3:8:1 4 4 5; 10:20:1 13:RIG_BINARY=alt; 10:20:1 13"
export OBSERVE=1 KEEP_INFRA=0
# The audit driver is pinned in the shell, by absolute path (not committed here):
#   export QOS1_DRIVER_ARCHIVE=<emqtt-bench 0.6.3 + audit extension from qos1-driver/, built
#   for linux/amd64 on 2026-10-20: archive sha256 d765e908..., image sha256:ab924082...>
