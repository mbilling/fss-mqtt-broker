# ADR 0089 on main (#1083): the merged head rule (A2, A5), backoff (A3) and window
# (A1) against the T5 baseline, and the 1.3.0 defaults (segment log store + 50 ms +
# prefer-local) at 3 nodes, ONE provisioning. Shape = elision-window-n3-fb90e03.env:
# a site is 600 publishers x 10 msg/s x 200 B = 6,000 msg/s into a $share group of 20
# persistent consumers (session expiry 30 s), 2 copies.
#   T5 (2026-10-21, before A2/A5): at 10 sites 5 ms elided 1.5%, 50 ms 98.1%; at 15
#   sites 50 ms elided 38.3% and carried 71,268 msg/s, the knee between 10 and 15.
#   Arm 1: window 0, crossing forced (MQTTD_SHARED_PREFER_LOCAL=0). The baseline.
#   Arm 2: 5 ms, crossing forced: whether A2/A5 rescue a short window.
#   Arm 3: 50 ms, crossing forced: whether A2/A5 lift the 15-site share and the knee.
#   Arm 4: 50 ms, prefer-local on (the default).
#   Arm 5: the segment log store, window 0, prefer-local on: the log store's baseline.
#   Arm 6: the log store + 50 ms + prefer-local on: the 1.3.0 defaults at 3 nodes.
#   Arm 7: window 0, crossing forced again: the drift control.
# Not covered: a lagging subscriber. The audit driver acknowledges at once and has no
# ack-delay knob; criterion 2 rests on the hub cost-model tests and DURABLE-PATH
# Result 4. LANE_E_STOP_AFTER_FAILS=3 so the start-up overflow (#1078) on an arm's
# first loaded rung cannot end a ladder on its own.
# Read per broker: mqttd_publish_delivered_total, mqttd_durable_elided_total,
# mqttd_durable_elision_fallback_total{reason}, mqttd_durable_elision_hold_seconds,
# mqttd_durable_elision_backoff_total, mqttd_publish_forwarded_total.
# Result: ../elision-ab-n3-2026-10-22.md. Driver: ../482-per-node-knee.sh.
#
# The binary is an UNRELEASED candidate: main at ff3607daafd237fa71f950678494edebed9810f2 built with the release recipe
# (scripts/release/build-repro.sh x86_64-unknown-linux-musl mqttd, Ubuntu 24.04 amd64,
# Rust 1.97.0), published as the pre-release bench-candidate-ff3607d. Stamped
# UNRELEASED-BINARY.txt.
export MQTTD_VERSION=main-ff3607d
export MQTTD_URL=https://github.com/mbilling/fss-mqtt-broker/releases/download/bench-candidate-ff3607d/mqttd-x86_64-unknown-linux-musl
export MQTTD_SHA256=58d26b30f1aaf0b9be9f8d4d47d54bd115b091fee8925cbe6d4e9b84ba076722
export BENCH_GIT_REF=ff3607d
export LANES=E CLOUD=hcloud
export BROKER_TYPE=ccx23 DRIVER_TYPE=ccx33 DRIVER_COUNT=8
export TF_VAR_build_bench=false
export LANE_E_QOS=1 LANE_E_SUB_QOS=1
export LANE_E_SESSION_EXPIRY=30
export LANE_E_SITE_RATE=6000 LANE_E_PUBS_PER_SITE=600 LANE_E_SUBS_PER_SITE=20
export LANE_E_SUB_CONTAINERS_PER_SITE=2 LANE_E_PUB_CONTAINERS_PER_SITE=1
export LANE_E_PLACEMENT=container LANE_E_PIN_SITES=0
export LANE_E_PAYLOAD=200
export LANE_E_SECS=60 LANE_E_CONTROL=1
export LANE_E_FORWARD_CANARY=1 LANE_E_CALIBRATE=0
export LANE_E_STOP_AFTER_FAILS=3
export KNEE_ARMS="3:8:1 10 15:MQTTD_SHARED_PREFER_LOCAL=0,MQTTD_DURABLE_WRITE_ELISION_MS=0; 3:8:1 10 15:MQTTD_SHARED_PREFER_LOCAL=0,MQTTD_DURABLE_WRITE_ELISION_MS=5; 3:8:1 10 15 20:MQTTD_SHARED_PREFER_LOCAL=0,MQTTD_DURABLE_WRITE_ELISION_MS=50; 3:8:1 10 15 20:MQTTD_DURABLE_WRITE_ELISION_MS=50; 3:8:1 15 20:MQTTD_REPLICA_STORE=log,MQTTD_DURABLE_WRITE_ELISION_MS=0; 3:8:1 15 20 24:MQTTD_REPLICA_STORE=log,MQTTD_DURABLE_WRITE_ELISION_MS=50; 3:8:1 10:MQTTD_SHARED_PREFER_LOCAL=0,MQTTD_DURABLE_WRITE_ELISION_MS=0"
export OBSERVE=1 KEEP_INFRA=0
# Audit driver, pinned in the shell (not committed): QOS1_DRIVER_ARCHIVE = emqtt-bench
# 0.6.3 + qos1-driver/, linux/amd64, archive sha256 d765e908..., image sha256:ab924082...
