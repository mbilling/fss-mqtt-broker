# Three-node QoS 1 curve point — see docs/benchmarks/QOS1-SCALE-CURVE.md
# Three-node QoS 1 point at the allocation the 5-node run qualified.
# FIXED allocation: varying it is what made the first 3-node run calibration-only.
export MQTTD_VERSION=1.0.17 LANES=E CLOUD=hcloud
export QOS1_SIZES=3
export BROKER_TYPE=ccx23 DRIVER_TYPE=ccx33 DRIVER_COUNT=8
export TF_VAR_build_bench=false
export LANE_E_QOS=1 LANE_E_SUB_QOS=1
export LANE_E_PUBS_PER_SITE=3000 LANE_E_SUBS_PER_SITE=10
export LANE_E_SUB_CONTAINERS_PER_SITE=2 LANE_E_PUB_CONTAINERS_PER_SITE=4
# 4 sites = 120,000 msg/s = 40,000/node, three repetitions for qualification.
# 24 containers over 8 drivers = 3.0 each, the density that ran clean at 5 nodes.
# 4,000 gated publishes per broker against PENDING_PUBLISH_CAP=4096 — under it,
# and the earlier 3-node run recorded zero pending-cap drops at this shape.
export LANE_E_SITES_OVERRIDE="1 2 4 4 4"
export LANE_E_PLACEMENT=container LANE_E_PIN_SITES=0
export LANE_E_SECS=60 LANE_E_CONTROL=1
export LANE_E_FORWARD_CANARY=1 LANE_E_CALIBRATE=0
export OBSERVE=0 KEEP_INFRA=0
