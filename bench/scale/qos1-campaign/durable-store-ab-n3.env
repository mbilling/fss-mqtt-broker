# Durable QoS 1 — redb vs the segment log on ONE provisioning (ADR 0078 T4, #662).
# Driver: 482-per-node-knee.sh. Shape: durable-calibrate-n3.env, which it sources.
#
# The 2026-09-28 calibrations ran each store on its own provisioning, and the
# three CCX23 disks of one provisioning were already 3.5x apart in flush rate
# (barrier floors 804 to 2,819/s): a store comparison across provisionings is
# a comparison across disks. Here both stores run on the SAME three brokers,
# each arm a fresh cluster on empty stores, and the closing arm repeats the log
# store's 6-site rung as the drift control.
#
# Run it on a binary that carries the truncate-flusher fix, the in-order lane
# completions and the mimalloc allocator (ADR 0079) — the 2026-09-28 log run
# failed its 6- and 9-site rungs on the flusher's false queue-overflow drops.
#
# Quota and ladder as the calibration: 3 x CCX23 + 8 x CCX33, sites x 2k msg/s
# per node. 21 sites is the fleet's honest ceiling (63 containers on 64 vCPU).
#   export MQTTD_VERSION=<candidate> MQTTD_URL=... MQTTD_SHA256=...
#   export QOS1_DRIVER_ARCHIVE=<audited driver>
#   set -a; . ./qos1-campaign/durable-store-ab-n3.env; set +a
. "$(dirname "${BASH_SOURCE[0]}")/durable-calibrate-n3.env"
export KNEE_ARMS="3:8:1 3 6 9 12 15 18 21:MQTTD_REPLICA_STORE=redb; 3:8:1 3 6 9 12 15 18 21:MQTTD_REPLICA_STORE=log; 3:8:1 6:MQTTD_REPLICA_STORE=log"
# Live dashboards: the observability stack attaches to every arm.
export OBSERVE=1
