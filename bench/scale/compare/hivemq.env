# HiveMQ CE for the cloud single-node comparison. The CE image ships the
# allow-all-clients extension disabled; HIVEMQ_ALLOW_ALL_CLIENTS=true is how the
# vendor documents opening it for testing, which is this lane's anonymous posture.
# HIVEMQ_HEAPSIZE is set per arm from the host's RAM by compare-brokers.sh: the
# JVM's default heap is a fraction of host memory, so leaving it implicit would
# silently give HiveMQ a different share of a 4 vCPU host than of a 32 vCPU one,
# and the vertical-scaling arm would measure the JVM default, not the broker.
HIVEMQ_ALLOW_ALL_CLIENTS=true
