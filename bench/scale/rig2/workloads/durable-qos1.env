# durable-qos1 — the prime target (ADR 0090 D3): QoS 1 publishes into $share groups of
# PERSISTENT consumers (clean_start=false, session expiry 30 s, as lane E's durable
# consumers), 200-byte payloads. The cluster runs durable (bootstrap-cluster.sh
# durable), so every delivery owes a durable append.
#
# Values here are defaults: anything exported in the environment wins.
QOS=${QOS:-1}
SHAPE=${SHAPE:-share}
SESSIONS=${SESSIONS:-durable}
SESSION_EXPIRY=${SESSION_EXPIRY:-30}
PAYLOAD=${PAYLOAD:-200}
# Topics per generator process. Each generator publishes under its own prefix, so a
# topic's publishers and consumers always live in one process (one clock).
TOPICS=${TOPICS:-20}
# Consumers per topic and group. auto = one per broker: connections are dealt round-robin
# over the brokers, so every broker holds a member of every group (prefer-local).
CONSUMERS=${CONSUMERS:-auto}
SHARE_GROUPS=${SHARE_GROUPS:-1}
# 50 msg/s per publisher with 128 in flight holds the offer through 2.56 s of ack
# latency, well past the 1 s band (Receive Maximum defaults to 256).
RATE_PER_PUBLISHER=${RATE_PER_PUBLISHER:-50}
INFLIGHT=${INFLIGHT:-128}
LATENCY_GATE=${LATENCY_GATE:-ack}
# Where the ramp starts, per tier (msg/s offered across the whole cluster).
START_RATE_local=${START_RATE_local:-500}
START_RATE_n3=${START_RATE_n3:-10000}
START_RATE_n10=${START_RATE_n10:-30000}
START_RATE_h3=${START_RATE_h3:-30000}
