# qos0 (ADR 0090 D3): QoS 0 publishes into $share groups of clean-session consumers,
# 200-byte payloads. There is no PUBACK, so the latency bands apply to END-TO-END p99
# (LATENCY_GATE=e2e), and loss is the ledger's missing count plus broker drops.
QOS=${QOS:-0}
SHAPE=${SHAPE:-share}
SESSIONS=${SESSIONS:-clean}
SESSION_EXPIRY=${SESSION_EXPIRY:-0}
PAYLOAD=${PAYLOAD:-200}
TOPICS=${TOPICS:-20}
CONSUMERS=${CONSUMERS:-auto}
SHARE_GROUPS=${SHARE_GROUPS:-1}
RATE_PER_PUBLISHER=${RATE_PER_PUBLISHER:-100}
INFLIGHT=${INFLIGHT:-128}
LATENCY_GATE=${LATENCY_GATE:-e2e}
START_RATE_local=${START_RATE_local:-5000}
START_RATE_n3=${START_RATE_n3:-50000}
START_RATE_n10=${START_RATE_n10:-150000}
