# clean-qos1 (ADR 0090 D3): QoS 1 publishes into $share groups of CLEAN-session
# consumers, 200-byte payloads. The cluster is the same durable cluster; mqttd writes
# durably only for persistent subscriber sessions, so this measures the routing path.
QOS=${QOS:-1}
SHAPE=${SHAPE:-share}
SESSIONS=${SESSIONS:-clean}
SESSION_EXPIRY=${SESSION_EXPIRY:-0}
PAYLOAD=${PAYLOAD:-200}
TOPICS=${TOPICS:-20}
CONSUMERS=${CONSUMERS:-auto}
SHARE_GROUPS=${SHARE_GROUPS:-1}
RATE_PER_PUBLISHER=${RATE_PER_PUBLISHER:-50}
INFLIGHT=${INFLIGHT:-128}
LATENCY_GATE=${LATENCY_GATE:-ack}
START_RATE_local=${START_RATE_local:-2000}
START_RATE_n3=${START_RATE_n3:-30000}
START_RATE_n10=${START_RATE_n10:-90000}
START_RATE_h3=${START_RATE_h3:-90000}
