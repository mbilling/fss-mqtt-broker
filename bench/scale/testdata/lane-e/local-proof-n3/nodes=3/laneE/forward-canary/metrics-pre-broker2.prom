# HELP mqttd_lease_quorum_ack_ms Milliseconds since the lease-group leader last had a quorum ack (0 when not leader).
# TYPE mqttd_lease_quorum_ack_ms gauge
mqttd_lease_quorum_ack_ms 0
# HELP mqttd_store_bytes On-disk size of each redb store in bytes (ADR 0041 T5), by store (sessions, retained, replicas, lease).
# TYPE mqttd_store_bytes gauge
mqttd_store_bytes{store="retained"} 1589248
mqttd_store_bytes{store="replicas"} 1589248
mqttd_store_bytes{store="sessions"} 0
mqttd_store_bytes{store="lease"} 1589248
# HELP mqttd_quic_path_migrations QUIC connection path migrations observed (client address changed; same connection and session kept).
# TYPE mqttd_quic_path_migrations counter
mqttd_quic_path_migrations_total 0
# HELP mqttd_retained_apply_failed Committed retained updates the local store REFUSED to write. Non-zero means this node is missing retained values its peers hold; the topic is repaired by the next commit or the periodic digest, but a persistent rate means the store is unhealthy and this node serves stale retained state.
# TYPE mqttd_retained_apply_failed counter
mqttd_retained_apply_failed_total 0
# HELP mqttd_retained_divergence Retained-message divergences detected between peers (same topic, different value — ADR 0037 P1); should stay at zero once single-owner retained lands.
# TYPE mqttd_retained_divergence counter
mqttd_retained_divergence_total 0
# HELP mqttd_retained_queue_dropped Retained mutations dropped because the queue-until-heal bound was hit (ADR 0037 §5): the oldest queued mutation discarded, loudly — non-zero means a partition outlasted the queue's capacity.
# TYPE mqttd_retained_queue_dropped counter
mqttd_retained_queue_dropped_total 0
# HELP mqttd_audit_export_dropped Audit records the SIEM exporter shed because its bounded queue was full (ADR 0066 T3): the chain itself is intact at the source, and the export's seq gap makes the shed detectable downstream — non-zero means the export endpoint is slower than the audit rate.
# TYPE mqttd_audit_export_dropped counter
mqttd_audit_export_dropped_total 0
# HELP mqttd_publish_tier Gated publishes by publisher-selected durability tier (ADR 0072): quorum (the default full ack-after-quorum), local (ack after the owner's fsync), relaxed (ack at accept+submit). Non-default tiers require the operator's MQTTD_ALLOW_RELAXED_PUBLISH opt-in.
# TYPE mqttd_publish_tier counter
mqttd_publish_tier_total{tier="quorum"} 4
# HELP mqttd_durable_writer_batches Fsync'd batches the node-wide durable-write serializer committed (ADR 0071): each batch is one Durability::Immediate transaction covering owner appends and follower replica applies that arrived while the previous fsync ran.
# TYPE mqttd_durable_writer_batches counter
mqttd_durable_writer_batches_total 0
# HELP mqttd_durable_writer_ops Durable ops applied across all serializer batches (ADR 0071); divided by durable_writer_batches this is the mean group-commit batch size — 1.0 at rest, rising under load as coalescing pays.
# TYPE mqttd_durable_writer_ops counter
mqttd_durable_writer_ops_total 0
# HELP mqttd_durable_writer_max_batch Largest single group-commit batch since boot (ADR 0071).
# TYPE mqttd_durable_writer_max_batch gauge
mqttd_durable_writer_max_batch 0
# HELP mqttd_durable_writer_commit_micros Cumulative microseconds the durable-write serializer spent committing batches (ADR 0076): divided by durable_writer_batches over the same window this is the LIVE mean commit (barrier) latency — the passive volume-health signal, measured from real traffic.
# TYPE mqttd_durable_writer_commit_micros counter
mqttd_durable_writer_commit_micros_total 0
# HELP mqttd_store_barrier_floor Boot-probed single-writer barrier rate (fsync round trips per second) of the data-dir volume (ADR 0076): the denominator every durable throughput figure should be read against; 0 until probed.
# TYPE mqttd_store_barrier_floor gauge
mqttd_store_barrier_floor 152824
# HELP mqttd_store_barrier_floor_4stream Boot-probed AGGREGATE barrier rate across 4 concurrent writers on separate files (ADR 0076): how much parallel-stream headroom the volume has beyond one fsync stream — the sharding signal; 0 until probed.
# TYPE mqttd_store_barrier_floor_4stream gauge
mqttd_store_barrier_floor_4stream 43572
# HELP mqttd_store_shards How many files the replica store spans (ADR 0076 T2): committed at first boot from this volume's measured barrier knee and fixed for the life of the data dir; 1 for a single-file store.
# TYPE mqttd_store_shards gauge
mqttd_store_shards 0
# HELP mqttd_store_reshard_advice The shard count this volume's measurements now suggest (ADR 0076 T2), when it differs from the committed one — an ADVISORY for the operator, never an automatic migration; 0 when the committed layout still fits.
# TYPE mqttd_store_reshard_advice gauge
mqttd_store_reshard_advice 0
# HELP mqttd_store_max_bytes The configured disk high-water mark in bytes (MQTTD_STORE_MAX_BYTES); 0 = no watermark configured.
# TYPE mqttd_store_max_bytes gauge
mqttd_store_max_bytes 0
# HELP mqttd_process_resident_bytes Resident set size of the broker process in bytes (ADR 0041 T8).
# TYPE mqttd_process_resident_bytes gauge
mqttd_process_resident_bytes 19709952
# HELP mqttd_memory_max_bytes The configured memory high-water mark in bytes (MQTTD_MEMORY_MAX_BYTES); 0 = no watermark configured.
# TYPE mqttd_memory_max_bytes gauge
mqttd_memory_max_bytes 0
# HELP mqttd_decommission_state Decommission drain state (ADR 0043/0054): 0 = none, 1 = draining, 2 = complete.
# TYPE mqttd_decommission_state gauge
mqttd_decommission_state 0
# HELP mqttd_decommission_pending Hand-offs still pending in an active decommission drain.
# TYPE mqttd_decommission_pending gauge
mqttd_decommission_pending 0
# HELP mqttd_voters Current lease-group voter count (ADR 0049/0054).
# TYPE mqttd_voters gauge
mqttd_voters 3
# HELP mqttd_replica_groups_current Replicated groups this node tracks that list it as caught up (ADR 0054); tracked minus current is this node's replication lag in groups.
# TYPE mqttd_replica_groups_current gauge
mqttd_replica_groups_current 256
# HELP mqttd_replica_groups_tracked Replicated groups this node tracks a caught-up set for (ADR 0054).
# TYPE mqttd_replica_groups_tracked gauge
mqttd_replica_groups_tracked 256
# HELP mqttd_cluster_info The cluster identity this node belongs to (ADR 0054 T2), as a build_info-style label; two distinct values across a fleet = split brain.
# TYPE mqttd_cluster_info gauge
mqttd_cluster_info{cluster_id="0a2ebd1b7d8ef48d32d661d9e6d3e83e"} 1
# HELP mqttd_founder 1 if this node founded the cluster (started seedless), else 0.
# TYPE mqttd_founder gauge
mqttd_founder 0
# HELP mqttd_refound_quarantine 1 if this node re-founded a cluster beside a live one and has taken ITSELF out of rotation (it will not become ready again without the documented wipe-and-rejoin), else 0.
# TYPE mqttd_refound_quarantine gauge
mqttd_refound_quarantine 0
# HELP mqttd_backup_last_success_timestamp_seconds Unix time the newest SUCCESSFUL export started (ADR 0062); 0 = no backup has ever succeeded in this process. Its age bounds the RPO.
# TYPE mqttd_backup_last_success_timestamp_seconds gauge
mqttd_backup_last_success_timestamp_seconds 0
# HELP mqttd_backup_duration_ms Wall-clock milliseconds the last export took. An UPPER BOUND on the consistency window, not the window itself — the window is the span the records were actually read over, exported separately (ADR 0062).
# TYPE mqttd_backup_duration_ms gauge
mqttd_backup_duration_ms 0
# HELP mqttd_restore_state Restore-from-backup state (ADR 0062): 0 none, 1 in progress (the node is NotReady and has bound no client listener), 2 completed, 3 failed.
# TYPE mqttd_restore_state gauge
mqttd_restore_state 0
# HELP mqttd_foundings Cluster-identity foundings by this process; anything beyond the very first boot of a brand-new cluster indicates a split-brain founding.
# TYPE mqttd_foundings counter
mqttd_foundings_total 0
# HELP mqttd_config_info Checksum of the loaded config file (ADR 0054 T3), build_info-style; after a config roll every node must report the same value.
# TYPE mqttd_config_info gauge
mqttd_config_info{checksum="e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"} 1
# HELP mqttd_swim_keys_accepted SWIM gossip keys currently accepted (ADR 0054 T3): 1 steady, 2 = a rotation window is open.
# TYPE mqttd_swim_keys_accepted gauge
mqttd_swim_keys_accepted 1
# HELP mqttd_swim_isolated 1 while this node's own SWIM probes go unanswered past the isolation threshold (issue #368): its membership view is unconfirmed and peers are likely evicting it — a one-way network failure looks exactly like this and like nothing else.
# TYPE mqttd_swim_isolated gauge
mqttd_swim_isolated 0
# HELP mqttd_peer_proto_min Oldest peer-bus protocol version this build speaks (ADR 0038).
# TYPE mqttd_peer_proto_min gauge
mqttd_peer_proto_min 6
# HELP mqttd_peer_proto_max Newest peer-bus protocol version this build speaks (ADR 0038).
# TYPE mqttd_peer_proto_max gauge
mqttd_peer_proto_max 8
# HELP mqttd_build_info Build information.
# TYPE mqttd_build_info gauge
mqttd_build_info{version="1.0.16"} 1
# HELP mqttd_crypto_module_info The crypto module this binary runs (ADR 0068): aws-lc-rs, or the FIPS-validated module in a fips build — so an auditor verifies the RUNNING binary, not the artifact's name.
# TYPE mqttd_crypto_module_info gauge
mqttd_crypto_module_info{module="aws-lc-rs"} 1
# EOF
