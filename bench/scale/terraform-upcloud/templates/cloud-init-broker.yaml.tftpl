#cloud-config
# Broker host for the scale curve — the UpCloud variant of the Hetzner rig's
# cloud-init-broker.yaml.tftpl. Same steps (deploy/systemd/README.md 1-4 minus
# secrets): the broker is enabled but NOT started — without its SWIM key and
# TLS material the shipped config fails closed by design, and
# bootstrap-cluster.sh starts it only after pushing them.
#
# Platform deltas vs Hetzner:
#   - the SSH key arrives via the login block, not ssh_authorized_keys, and
#     password delivery is off, so there is no expired-root-password trap to
#     defuse (the chpasswd/runcmd belt-and-braces is kept anyway — it is free)
#   - the private SDN interface exists before first boot and DHCP (which
#     serves the terraform-reserved address) configures it in the normal
#     network pass — the netplan hot-attach fix-up is unnecessary here

chpasswd:
  expire: false

package_update: true
packages:
  - curl
  - jq
  - chrony
  - sysstat
  - ethtool

users:
  - name: mqttd
    system: true
    shell: /usr/sbin/nologin

write_files:
  - path: /etc/systemd/system/mqttd.service
    permissions: "0644"
    content: |
      ${indent(6, mqttd_service_unit)}
  - path: /etc/systemd/system/mqttd.service.d/override.conf
    permissions: "0644"
    content: |
      ${indent(6, mqttd_override)}
  - path: /etc/sysctl.d/99-mqttd-bench.conf
    permissions: "0644"
    content: |
      ${indent(6, sysctl_conf)}

runcmd:
  - chage -d now root && passwd -l root
  - sysctl --system
  # Directories per deploy/systemd/README.md: config root readable by the
  # service group, data dir private to the service user.
  - install -d -m 0750 -o root -g mqttd /etc/mqttd /etc/mqttd/tls
  - install -d -m 0700 -o mqttd -g mqttd /var/lib/mqttd
  # Probe scratch on the SAME filesystem as the data dir, so the barrier probe
  # measures the volume the broker actually commits on. NOTE: on UpCloud that
  # volume is network-replicated maxiops, not local NVMe — a recorded
  # deviation from ADR 0048 §2 (see ../brokers.tf's header).
  - install -d -m 0777 /var/lib/mqttd-probe
  # The released, signed, byte-reproducible binary — hard-fail on checksum
  # mismatch so a bad download is a loud cloud-init error, not a silent variable.
  - |
    set -e
    NAME="mqttd-${mqttd_version}-x86_64-unknown-linux-musl"
    cd /tmp
%{ if mqttd_url != "" ~}
    curl -fsSL -o "$NAME" "${mqttd_url}"
    echo "${mqttd_sha256}  $NAME" | sha256sum -c -
    echo "UNRELEASED BROKER: fetched from ${mqttd_url}, verified against the pinned hash." >&2
%{ else ~}
    BASE="https://github.com/mbilling/fss-mqtt-broker/releases/download/v${mqttd_version}"
    curl -fsSLO "$BASE/$NAME"
%{ if mqttd_sha256 != "" ~}
    echo "${mqttd_sha256}  $NAME" | sha256sum -c -
%{ else ~}
    curl -fsSLO "$BASE/$NAME.sha256"
    sha256sum -c "$NAME.sha256"
%{ endif ~}
%{ endif ~}
    install -m 0755 "$NAME" /usr/local/bin/mqttd
    rm -f "$NAME" "$NAME.sha256"
  - systemctl daemon-reload
  - systemctl enable mqttd
  - touch /run/bench-cloudinit-done
