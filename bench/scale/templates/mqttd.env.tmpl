# /etc/mqttd/mqttd.env for a scale-curve broker — rendered per node by
# bench/scale/bootstrap-cluster.sh from deploy/systemd/mqttd.env.example's shape.
# @TOKENS@ are substituted at render time; everything else is deliberate and
# disclosed in docs/benchmarks/SCALE-CURVE.md's configuration section.

# ── identity / topology (the example file's five per-host edits) ──────────────
MQTTD_NODE_ID=@NODE_ID@
MQTTD_PEER_ADVERTISE=@PRIVATE_IP@:7001
MQTTD_SWIM_SEEDS=@SWIM_SEEDS@
MQTTD_READY_MIN_MEMBERS=@READY_MIN_MEMBERS@
MQTTD_SWIM_KEY_FILE=/etc/mqttd/swim.key

# ── TLS (cluster PKI from deploy/systemd/gen-certs.sh) ────────────────────────
MQTTD_TLS_BIND=0.0.0.0:8883
MQTTD_TLS_CERT=/etc/mqttd/tls/server.pem
MQTTD_TLS_KEY=/etc/mqttd/tls/server.key
# The mTLS posture's client CA — minted by bench/tls/gen-certs.sh, NEVER the
# peer CA (the env example explains why that would be a privilege escalation).
MQTTD_TLS_CLIENT_CA=/etc/mqttd/tls/client-ca.pem
MQTTD_PEER_TLS_CA=/etc/mqttd/tls/peer-ca.pem
MQTTD_PEER_TLS_CERT=/etc/mqttd/tls/peer.pem
MQTTD_PEER_TLS_KEY=/etc/mqttd/tls/peer.key

# ── fixed plumbing ────────────────────────────────────────────────────────────
MQTTD_DATA_DIR=/var/lib/mqttd
# 0.0.0.0, unlike the example's 127.0.0.1: the drivers scrape /metrics and gate
# on /readyz over the private network. The public side is firewalled to SSH only.
MQTTD_HEALTH_BIND=0.0.0.0:8080
MQTTD_PEER_BIND=0.0.0.0:7001
MQTTD_SWIM_BIND=0.0.0.0:7946
MQTTD_SHUTDOWN_GRACE=30
RUST_LOG=warn

# ── benchmark posture (disclosed, per lane) ───────────────────────────────────
# Plaintext posture: the listener binds the PRIVATE ip only — nothing public.
# Anonymous auth mirrors bench/'s disclosed comparative posture; the curve
# measures the broker, not Argon2id.
MQTTD_PLAINTEXT_BIND=@PRIVATE_IP@:1883
MQTTD_ALLOW_ANONYMOUS=1
# Lanes B/C run the broker with the durable plane off (parity with bench/'s
# non-durable posture); lane A runs it on. Rendered per lane, broker restarted.
@DURABLE_LINE@
# ADR 0072: the tier-showcase lane publishes with mqttd-durability set; the
# double opt-in's operator half is ON for the benchmark and DISCLOSED here.
# Default lanes' v3.1.1 publishers carry no property, so they are unaffected.
MQTTD_ALLOW_RELAXED_PUBLISH=1

# ── bounds sized for the 50k-connection lane (docs/SIZING.md) ─────────────────
MQTTD_MAX_CONNECTIONS=60000
MQTTD_MAX_SESSIONS=60000
# TOKIO_WORKER_THREADS deliberately unset: real hosts run the shipped default,
# and the published numbers say so (DURABLE-PATH.md's rule).
