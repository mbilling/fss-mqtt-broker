# Market data / trading — BROADCAST FAN-OUT, latency above all.
#
# One publisher per instrument, many subscribers on a wildcard, QoS 0 (a stale
# tick is worthless — shed it rather than queue it), p99 in single-digit ms.
# Delivered work is offered x LANE_B_SUBS, so this is the shape that stresses
# the per-connection EGRESS path (issue #443's write batching).
#
# Ladder brackets the ~700k deliveries/s peak measured 2026-08-26:
#   4800 offered x 240 subs = 1.15M/s | 2400 = 576k/s | 1200 = 288k/s
LANES=B
LANE_B_QOS=0
LANE_B_FANOUT=100
LANE_B_PUBS_OVERRIDE=120
LANE_B_SUBS_OVERRIDE=240
LANE_B_PUB_CONTAINERS=1
LANE_B_SUB_CONTAINERS=2
LANE_B_RUNGS_OVERRIDE="4800 2400 1200"
# Tuning levers for the optimization pass (see README):
#   MQTTD_MAX_QUEUED_MESSAGES, MQTTD_QUEUE_OVERFLOW (drop-oldest is CORRECT
#   here), MQTTD_TOPIC_ALIAS_MAX.
