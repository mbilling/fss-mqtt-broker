# emergency-alerting — delivery amplification at its extreme
#
# Public-safety and mass-notification traffic: a handful of authorised publishers,
# an enormous audience, and every message must reach all of it. market-data is
# already fan-out (120 -> 240, 2x), but this is 10 -> 3000 — a 300x amplification
# where ONE publish becomes three thousand deliveries.
#
# That ratio is the point. It isolates the egress path from the ingress path
# completely: the broker receives almost nothing and must emit an enormous amount,
# so any per-delivery cost is multiplied 300-fold and shows up where a 2x fan-out
# hides it.
LANES=B
LANE_B_QOS=1
LANE_B_FANOUT=100

# 30 publishers = 2 containers x 15; 3000 subscribers = 2 x 1500. 15 and 1500 are
# both multiples of 15, so zero skew over 1, 3 and 5 brokers.
LANE_B_PUBS_OVERRIDE=30
LANE_B_SUBS_OVERRIDE=3000
LANE_B_PUB_CONTAINERS=1
LANE_B_SUB_CONTAINERS=1

# 300 msg/s offered becomes 300 x 3000 = 900 000 deliveries/s at the top rung —
# already past what the earlier fan-out ladder reached, from a thirtieth of the
# ingress.
LANE_B_RUNGS_OVERRIDE="300 150 60"
LANE_B_REF_RUNG=150
