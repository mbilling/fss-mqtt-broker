# wearables — the connection ceiling, past where smart-home stops
#
# smart-home establishes 50 000 idle connections and measures what one costs
# (~24.8 kB plaintext, flat across cluster sizes, measured 2026-08-26). That
# flatness is a claim about scaling, and it was only ever checked at one point.
#
# This triples it. A consumer-wearable fleet is the shape that finds the ceiling:
# 150 000 mostly-silent connections per cluster, which at the measured per-
# connection cost is ~3.7 GB of connection state — real, but inside the 12 GB
# MemoryMax the bench hosts run with, so a failure here is a finding rather than
# an OOM artifact.
LANES=C
LANE_C_CONNS=150000
LANE_C_RAMP=2500
LANE_C_HOLD=120

# 150 000 does not fit the template's 60 000 cap.
EXTRA_BROKER_ENV="MQTTD_MAX_CONNECTIONS=200000
MQTTD_MAX_SESSIONS=200000"
