# video-surveillance — bytes per second, not messages per second
#
# Every other shape in this directory publishes 256-byte telemetry, so the whole
# ladder measures MESSAGE rate and nothing measures EGRESS. A camera fleet is the
# opposite machine: modest message rates, 64 KB frames, and the constraint moves
# from routing to the per-connection write path, the backlog byte bound (issue
# #241) and MQTTD_MAX_PACKET_SIZE.
#
# 60 cameras -> 120 viewers with full fan-out: at the 480 msg/s rung that is
# 480 x 120 = 57 600 deliveries/s x 64 KB = ~3.7 GB/s of egress work, which is
# well past what the NICs carry — so the interesting result here is WHERE it
# breaks and what the broker does about it (drop reasons), not a headline TPS.
LANES=B
LANE_B_QOS=0
LANE_B_FANOUT=100
LANE_B_PAYLOAD=65536

# 60 publishers = 4 containers x 15; 120 subscribers = 4 x 30. Both divide 1, 3
# and 5 brokers with zero skew (15 and 30 are multiples of 15); 7 and 10 do NOT
# divide them, so this shape is a 1/3/5 curve by construction.
LANE_B_PUBS_OVERRIDE=60
LANE_B_SUBS_OVERRIDE=120
LANE_B_PUB_CONTAINERS=2
LANE_B_SUB_CONTAINERS=2

# 60 publishers x 1000/interval: 480 = 8 msg/s each (a low frame rate, which at
# 64 KB is already a large stream), 240 = 4/s, 120 = 2/s.
LANE_B_RUNGS_OVERRIDE="480 240 120"
LANE_B_REF_RUNG=240
