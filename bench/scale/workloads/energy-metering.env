# energy-metering — enormous topic cardinality at a trickle rate
#
# A smart-grid deployment is 100 000 meters each publishing ONE reading every ten
# seconds. The message rate is trivial; what is large is the number of distinct
# topics and the routing state behind them. This is the shape that tests whether
# the match trie and the per-session records scale by TOPIC COUNT rather than by
# throughput — the dimension telematics (1 msg/s each) only half touches, and the
# one the filter-interning and subscription-record work (v1.0.10) exists for.
LANES=B
LANE_B_QOS=1
LANE_B_FANOUT=0

# 100 000 meters, one topic each (bench/%i), through a $share group of collectors.
# 420 subscribers = 210 per container, zero skew over 1/3/5/7/10.
LANE_B_PUBS_OVERRIDE=100000
LANE_B_SUBS_OVERRIDE=420
LANE_B_PUB_CONTAINERS=5
LANE_B_SUB_CONTAINERS=1

# 10 000 msg/s = one reading per meter per ten seconds, the real duty cycle.
# Deliberately far below saturation: the question is whether 100k topics costs
# anything at rest, not how fast the cluster can go.
LANE_B_RUNGS_OVERRIDE="10000"
LANE_B_REF_RUNG=10000

# 100 100 connections do not fit the rig template's 60 000 cap (see telematics).
EXTRA_BROKER_ENV="MQTTD_MAX_CONNECTIONS=150000
MQTTD_MAX_SESSIONS=150000"
