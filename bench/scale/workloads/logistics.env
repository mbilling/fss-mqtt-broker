# logistics — store-and-forward across an offline window (lane D)
#
# The shape no other lane has: the subscriber is ABSENT while the traffic
# arrives. A delivery fleet loses coverage in a tunnel or a depot, the platform
# keeps publishing route updates and proof-of-delivery requests to each vehicle,
# and the broker is expected to hold that traffic and hand it over intact when
# the vehicle comes back. Every other workload here measures a broker whose
# subscribers are connected; this one measures what it remembers for the ones
# that are not.
#
# What it stresses: per-session offline queues (ADR 0001 §6), session state
# across a disconnect, and — at N>1 — whether a session resumes against the
# node that owns it after reconnecting to a different one.
#
# The number that matters is NOT a rate. It is completeness: of everything the
# cluster accepted while the sessions were offline, how much was delivered on
# resumption, how long the backlog took to clear, and whether any shortfall is
# explained by a disclosed bound rather than silent loss.
LANES=D

# 1680 sessions = 4 containers (2 drivers x 2) x 420 each. 420 = 4 x 105, so it
# divides evenly over 1, 3, 5, 7 AND 10 brokers — every cluster size this rig
# documents. (1920 gave 480 per container, which divides 1/3/5 but NOT 7: the
# shape check refuses it rather than leave one node holding a remainder.)
LANE_D_SESSIONS_OVERRIDE=1680
LANE_D_CONTAINERS=2

# One publisher per session topic, offering 4000 msg/s for 40s: ~95 messages
# queued per session, 160 000 in flight across the cluster. Deliberately far
# under MQTTD_MAX_QUEUED_MESSAGES — at the cap this lane would measure the drop
# policy rather than the store-and-forward path.
LANE_D_RATE=4000
LANE_D_OFFLINE_SECS_OVERRIDE=40
LANE_D_QOS=1
LANE_D_PAYLOAD=256

# Must outlast offline+drain with margin, or a protocol-correct expiry would be
# reported as broker loss.
LANE_D_EXPIRY=900
LANE_D_DRAIN_SECS_OVERRIDE=180
