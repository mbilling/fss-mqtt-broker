# #482 / #613 per-node knee — N=7 vs N=5 on ONE provisioning (A/B/A)
# Card: 482-per-node-knee.md. Driver: 482-per-node-knee.sh.
# Quota: 7×CCX23 + 18×CCX33 = 28 + 144 = 172 vCPU on 25 servers (limit 30 / 200).
# Do NOT export HCLOUD_TOKEN in a committed file — set it in your shell.

export CLOUD=hcloud
# The binary is the operator's to name, and it must contain #640 (the O(peers)
# removal) — v1.0.17 does not. Pin a candidate for all three arms:
#   export MQTTD_VERSION=main-0a08187
#   export MQTTD_URL=https://…/mqttd-x86_64-unknown-linux-musl
#   export MQTTD_SHA256=<sha256 of that file>
#   export BENCH_GIT_REF=<one commit, for every arm>

# 18, not 10: one driver per site at the top rung (18 sites), so EVERY rung of
# both arms runs at the same density — at most one site, 3 containers, on an
# 8-vCPU driver. At 10, N=7's 60k/node rung (14 sites) put two sites on four
# drivers while N=5's (10 sites) put one on each: the matched rungs would have
# differed in driver load, at the density where the 2026-09-15 pair flagged
# PUBLISHERS LATE.
export DRIVER_COUNT=18
export BROKER_TYPE=ccx23
export DRIVER_TYPE=ccx33

# Option B's per-site shape, unchanged: one consumer container of 7 spans every
# broker at both sizes (covers C+K-1 = 7 ≥ N), so predicted crossing is 0%.
export LANES=E
export LANE_E_PIN_SITES=0
export LANE_E_SUBS_PER_SITE=7
export LANE_E_SUB_CONTAINERS_PER_SITE=1
export LANE_E_PUBS_PER_SITE=1200
export LANE_E_PUB_CONTAINERS_PER_SITE=2
export LANE_E_SITE_RATE=30000
export LANE_E_QOS=0
export LANE_E_SUB_QOS=0
export LANE_E_PAYLOAD=200
export LANE_E_CALIBRATE=1
export LANE_E_CONTROL=1                 # every ladder closes on its bottom rung

# Ladders matched in PER-NODE offer (site rate 30 000; per node = 30 000 × sites / N):
#   per node   30k  42k  48k  54-56k  60k  64-66k  72k  77-78k
#   N=5 sites   5    7    8     9     10     11    12    13
#   N=7 sites   7   10   11    13     14     15    17    18
# The 60k/node rung runs twice (where N=5 strained on 2026-09-15). The leading 1
# is the control that each arm repeats at its end.
export KNEE_FULL=7
export KNEE_SMALL=5
export KNEE_LADDER_FULL="1 7 10 11 13 14 14 15 17 18"
export KNEE_LADDER_SMALL="1 5 7 8 9 10 10 11 12 13"
# The closing arm returns to 7 only to prove the hardware did not drift: its
# control and its 60k/node rung must match the opening arm's within ~1%.
export KNEE_LADDER_CLOSE="1 14"

export OBSERVE=1
