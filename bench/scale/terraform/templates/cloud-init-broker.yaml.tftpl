#cloud-config
# Broker host for the scale curve: deploy/systemd/README.md steps 1-4, minus
# secrets. The broker is enabled but NOT started — without its SWIM key and TLS
# material the shipped config fails closed by design, and bootstrap-cluster.sh
# starts it only after pushing them.

# The operator's key rides in here rather than as an hcloud_ssh_key resource:
# API registration 409s when the key already exists in the project.
ssh_authorized_keys:
  - ${ssh_public_key}

# Without an API-registered key Hetzner sets a root password and marks it
# EXPIRED — PAM then demands an interactive change on every login, which kills
# every non-interactive SSH command ("Password change required but no TTY").
# Both halves of the fix: don't expire it, and lock it (key-only access).
chpasswd:
  expire: false

package_update: true
packages:
  - curl
  - jq
  - chrony
  - sysstat
  - ethtool

users:
  - name: mqttd
    system: true
    shell: /usr/sbin/nologin

write_files:
  - path: /etc/systemd/system/mqttd.service
    permissions: "0644"
    content: |
      ${indent(6, mqttd_service_unit)}
  - path: /etc/systemd/system/mqttd.service.d/override.conf
    permissions: "0644"
    content: |
      ${indent(6, mqttd_override)}
  - path: /etc/sysctl.d/99-mqttd-bench.conf
    permissions: "0644"
    content: |
      ${indent(6, sysctl_conf)}

runcmd:
  # Belt and braces for the expired-password trap above, in case the platform's
  # own config wins the merge: mark the password changed today and lock it.
  - chage -d now root && passwd -l root
  # The private-network attachment can land AFTER first boot's network pass, in
  # which case the platform never configures the private NIC at all (observed:
  # a host with clean cloud-init and no private address, forever). Configure it
  # deterministically: wait for the hot-plugged NIC (the one with no IPv4), then
  # DHCP it — Hetzner's DHCP answers with exactly the address terraform reserved
  # (${private_ip} here). netplan persists it across the retry reboot.
  - |
    for i in $(seq 1 90); do
      IFACE=$(ip -o link show | awk -F': ' '$2 != "lo" {print $2}' | while read -r n; do
        ip -o -4 addr show dev "$n" | grep -q . || { echo "$n"; break; }
      done)
      [ -n "$IFACE" ] && break
      sleep 2
    done
    if [ -n "$IFACE" ]; then
      printf 'network:\n  version: 2\n  ethernets:\n    %s:\n      dhcp4: true\n' "$IFACE" \
        > /etc/netplan/60-bench-private.yaml
      chmod 600 /etc/netplan/60-bench-private.yaml
      netplan apply
    else
      echo "no unconfigured NIC appeared for the private network (${private_ip})" >&2
    fi
  - sysctl --system
  # ISSUE #505: on this rig ONE core per broker carries all the network softirq
  # and saturates near 96% while the others idle — mqttd is squeezed off it
  # (user time fell 21.5% -> 10.9% as load rose, softirq 66.7% -> 81.8%). With
  # a single virtio RX queue every packet's bottom half runs on the one CPU the
  # IRQ is pinned to. This block spreads that work; `broker_nic_spread` gates it
  # so the tuned and untuned kernels are the SAME image otherwise, which is what
  # makes the A/B honest.
  #
  # Two mechanisms, deliberately both: `ethtool -L combined` asks the NIC for
  # real multi-queue (virtio offers it only if the host does, so this is
  # best-effort and must not fail the boot), while RPS steers packets to other
  # cores in software and works even when the device stays single-queue. RFS
  # then keeps a flow on the CPU its socket is read from, which matters here
  # because a broker's sockets are long-lived.
  - |
    if [ "${nic_spread}" = "true" ]; then
      NCPU=$(nproc)
      MASK=$(printf '%x' $(( (1 << NCPU) - 1 )))
      echo 32768 > /proc/sys/net/core/rps_sock_flow_entries || true
      for IF in $(ls /sys/class/net | grep -v '^lo$'); do
        ethtool -L "$IF" combined "$NCPU" 2>&1 | sed "s/^/nic-spread $IF ethtool: /" || true
        for Q in /sys/class/net/"$IF"/queues/rx-*; do
          [ -d "$Q" ] || continue
          echo "$MASK" > "$Q"/rps_cpus 2>/dev/null || true
          echo 2048   > "$Q"/rps_flow_cnt 2>/dev/null || true
        done
        echo "nic-spread $IF: rps_cpus=$MASK queues=$(ls -d /sys/class/net/$IF/queues/rx-* 2>/dev/null | wc -l)"
      done
    else
      echo "nic-spread: disabled (broker_nic_spread=false)"
    fi
  # Directories per deploy/systemd/README.md: config root readable by the
  # service group, data dir private to the service user.
  - install -d -m 0750 -o root -g mqttd /etc/mqttd /etc/mqttd/tls
  - install -d -m 0700 -o mqttd -g mqttd /var/lib/mqttd
  # Probe scratch on the SAME filesystem as the data dir, so the barrier probe
  # measures the volume the broker actually commits on.
  - install -d -m 0777 /var/lib/mqttd-probe
  # The released, signed, byte-reproducible binary — hard-fail on checksum
  # mismatch so a bad download is a loud cloud-init error, not a silent variable.
  #
  # `mqttd_url` overrides the source for measuring a binary that has not shipped.
  # It carries NO published `.sha256` companion, so the pinned hash is mandatory
  # there and the fallback below is unreachable on that path — verification is
  # never weaker, only sourced differently. run.sh refuses a URL without a hash
  # before terraform runs; this template would fail closed anyway, because with
  # neither branch supplying a checksum there is nothing to verify against.
  - |
    set -e
    NAME="mqttd-${mqttd_version}-x86_64-unknown-linux-musl"
    cd /tmp
%{ if mqttd_url != "" ~}
    curl -fsSL -o "$NAME" "${mqttd_url}"
    echo "${mqttd_sha256}  $NAME" | sha256sum -c -
    echo "UNRELEASED BROKER: fetched from ${mqttd_url}, verified against the pinned hash." >&2
%{ else ~}
    BASE="https://github.com/mbilling/fss-mqtt-broker/releases/download/v${mqttd_version}"
    curl -fsSLO "$BASE/$NAME"
%{ if mqttd_sha256 != "" ~}
    echo "${mqttd_sha256}  $NAME" | sha256sum -c -
%{ else ~}
    curl -fsSLO "$BASE/$NAME.sha256"
    sha256sum -c "$NAME.sha256"
%{ endif ~}
%{ endif ~}
    install -m 0755 "$NAME" /usr/local/bin/mqttd
    rm -f "$NAME" "$NAME.sha256"
  - systemctl daemon-reload
  - systemctl enable mqttd
  - touch /run/bench-cloudinit-done
