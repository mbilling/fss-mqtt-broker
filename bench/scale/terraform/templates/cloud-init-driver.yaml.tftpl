#cloud-config
# Load-generator host. Docker + the pinned emqtt-bench image carry lanes B/C;
# driver 1 additionally builds the durable_bench driver from a pinned ref of the
# repository (lane A and the barrier probes have no released artifact). The build
# runs in the background so it overlaps cluster bring-up; run.sh waits on the
# marker file before lane A.

# Key via cloud-init, not hcloud_ssh_key — see cloud-init-broker.yaml.tftpl,
# including the expired-root-password trap chpasswd/runcmd defuse below.
ssh_authorized_keys:
  - ${ssh_public_key}

chpasswd:
  expire: false

package_update: true
packages:
  - curl
  - jq
  - chrony
  - sysstat
  - docker.io
  - git
  - build-essential
  - pkg-config

write_files:
  - path: /etc/sysctl.d/99-bench-driver.conf
    permissions: "0644"
    content: |
      ${indent(6, sysctl_conf)}

runcmd:
  - chage -d now root && passwd -l root
  # Deterministic private-NIC config — see cloud-init-broker.yaml.tftpl.
  - |
    for i in $(seq 1 90); do
      IFACE=$(ip -o link show | awk -F': ' '$2 != "lo" {print $2}' | while read -r n; do
        ip -o -4 addr show dev "$n" | grep -q . || { echo "$n"; break; }
      done)
      [ -n "$IFACE" ] && break
      sleep 2
    done
    if [ -n "$IFACE" ]; then
      printf 'network:\n  version: 2\n  ethernets:\n    %s:\n      dhcp4: true\n' "$IFACE" \
        > /etc/netplan/60-bench-private.yaml
      chmod 600 /etc/netplan/60-bench-private.yaml
      netplan apply
    else
      echo "no unconfigured NIC appeared for the private network (${private_ip})" >&2
    fi
  - sysctl --system
  - systemctl enable --now docker
  - docker pull emqx/emqtt-bench:0.6.3
%{ if build_bench ~}
  - |
    nohup bash -c '
      set -e
      export HOME=/root CARGO_HOME=/root/.cargo RUSTUP_HOME=/root/.rustup
      curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal
      . /root/.cargo/env
      # The attach-race retry (cloud-init clean + reboot) re-runs this script;
      # a partial clone from the first boot must not wedge the second.
      rm -rf /opt/mqtt-broker
      git clone https://github.com/mbilling/fss-mqtt-broker /opt/mqtt-broker
      cd /opt/mqtt-broker
      git checkout ${bench_git_ref}
      cargo test --release -p mqttd --test durable_bench --no-run --locked
      BIN=$(ls -t /opt/mqtt-broker/target/release/deps/durable_bench-* | grep -v "\.d$" | head -1)
      printf "%s\n" "$BIN" > /run/bench-driver-build-done
    ' > /var/log/bench-build.log 2>&1 &
%{ endif ~}
  - touch /run/bench-cloudinit-done
