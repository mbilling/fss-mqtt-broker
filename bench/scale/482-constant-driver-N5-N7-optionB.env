# #482 constant-driver A/B — Option B (unpinned, C≥max N so crossing≈0%)
# Quota: 30 servers / 200 dedicated vCPUs (since 2026-09-15; the pair ran under 15/100)
# Shape: N∈{5,7}, D=5, CCX23 brokers + CCX33 drivers
# Do NOT export HCLOUD_TOKEN in a committed file — set it in your shell.

export CLOUD=hcloud
export MQTTD_VERSION=1.0.16          # replace with tip tag OR use MQTTD_URL+SHA256 for main tip
# For current main tip instead of the last Lane E release:
#   export MQTTD_VERSION=main-tip
#   export MQTTD_URL=https://…/mqttd-…musl
#   export MQTTD_SHA256=$(sha256sum mqttd-candidate | cut -d' ' -f1)
#   export BENCH_GIT_REF=<pin one commit for both arms>

export DRIVER_COUNT=5
export BROKER_TYPE=ccx23
export DRIVER_TYPE=ccx33

export LANES=E
export LANE_E_PIN_SITES=0
export LANE_E_SUBS_PER_SITE=7          # Option B: ≥ max(N)=7 → predicted cross≈0% at N=5 and N=7
export LANE_E_SUB_CONTAINERS_PER_SITE=1
export LANE_E_PUBS_PER_SITE=1200
export LANE_E_PUB_CONTAINERS_PER_SITE=2
export LANE_E_SITE_RATE=30000
export LANE_E_QOS=0
export LANE_E_SUB_QOS=0
export LANE_E_PAYLOAD=200
export LANE_E_CALIBRATE=1
export LANE_E_CONTROL=1

# Container budget on CCX33 (8 vCPU): 3 containers/site → busiest driver
# ceil(sites/5)*3 ≤ 8 ⇒ sites ≤ 10. Do not use 12/17-site rungs with D=5.
export LANE_E_SITES_OVERRIDE="1 2 4 8 10"

export OBSERVE=1                       # live graphs; set 0 only for purity publish
# KEEP_INFRA=0 by default — tear down between sizes
