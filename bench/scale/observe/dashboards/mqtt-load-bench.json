{
  "uid": "mqtt-load-bench",
  "title": "mqtt-load \u2014 generators (bench)",
  "tags": [
    "bench",
    "mqtt-load"
  ],
  "description": "Generated by bench/scale/observe/build-bench-dashboards.py \u2014 do not edit by hand. mqtt-load's --metrics endpoint (mqload_*) beside the brokers' counters, for rig2.",
  "schemaVersion": 39,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "title": "Run phase",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 3,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "description": "What bench/scale is doing right now. Blank broker panels during provisioning or teardown are CORRECT \u2014 the brokers do not exist yet \u2014 and this is how you tell that from a dead collector.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "bench_run_phase",
          "legendFormat": "{{phase}}",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "options": {
        "textMode": "name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "no run attached",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": []
        },
        "overrides": []
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Phase detail",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 3,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "bench_run_phase",
          "legendFormat": "{{detail}}",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "options": {
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "\u2014",
          "mappings": []
        },
        "overrides": []
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Generators reporting",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 3,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "description": "mqtt-load processes being scraped. 0 between rig2 steps is CORRECT: each step is its own process, and the endpoint exists only while it runs.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(up{job=\"mqtt-load\"} == 1)",
          "legendFormat": "generators",
          "refId": "A"
        }
      ],
      "options": {
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Offered, sent, acked, received (msg/s, all generators)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Offered is what the schedule made due; sent what was written. Sent below offered is the generator falling behind (see backlog). Received counts deliveries, so it is the offer times the deliveries per message.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(mqload_target_rate)",
          "legendFormat": "target",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(mqload_offered_total[10s]))",
          "legendFormat": "offered",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(mqload_sent_total[10s]))",
          "legendFormat": "sent",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(mqload_acked_total[10s]))",
          "legendFormat": "acked",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(mqload_received_total[10s]))",
          "legendFormat": "received",
          "refId": "E"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Brokers took the offer? (msg/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "The broker's own counters beside the generators'. The rig2 verdict needs the brokers to receive at least 99% of the offer over the measured window.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(mqttd_publish_received_total[10s]))",
          "legendFormat": "brokers received",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(mqttd_publish_delivered_total[10s]))",
          "legendFormat": "brokers delivered",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(mqload_sent_total[10s]))",
          "legendFormat": "generators sent",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Ack latency (PUBLISH to PUBACK)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Live and coarse: quantiles from mqtt-load's 16 Prometheus buckets over 30 s. The report's figures are the exact merge of every generator's HDR histogram over the measured window.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(mqload_ack_latency_seconds_bucket[30s])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(mqload_ack_latency_seconds_bucket[30s])))",
          "legendFormat": "p99",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.999, sum by (le) (rate(mqload_ack_latency_seconds_bucket[30s])))",
          "legendFormat": "p99.9",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "End-to-end latency (PUBLISH to delivery)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "The QoS 0 workload is gated on this. Same caveat as the ack panel.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(mqload_e2e_latency_seconds_bucket[30s])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(mqload_e2e_latency_seconds_bucket[30s])))",
          "legendFormat": "p99",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.999, sum by (le) (rate(mqload_e2e_latency_seconds_bucket[30s])))",
          "legendFormat": "p99.9",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Generator CPU (cores) and saturation",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "saturated = 1 when the current window crossed a generator threshold: such a step is VOID, never counted against the broker.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mqload_cpu_cores",
          "legendFormat": "{{instance}} cpu cores",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mqload_saturated",
          "legendFormat": "{{instance}} saturated",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Generator scheduling lag",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Due to written: sends the generator alone delayed.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(mqload_sched_lag_seconds_bucket[30s])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(mqload_sched_lag_seconds_bucket[30s])))",
          "legendFormat": "p99",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.999, sum by (le) (rate(mqload_sched_lag_seconds_bucket[30s])))",
          "legendFormat": "p99.9",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "In flight and backlog",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "In flight: QoS 1 publishes awaiting PUBACK. Backlog: messages due and not yet written.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance) (mqload_inflight)",
          "legendFormat": "{{instance}} in flight",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance) (mqload_backlog)",
          "legendFormat": "{{instance}} backlog",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Errors and ledger anomalies (per s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "All zero in a clean step. Missing messages are only known at the drain: see the step's verdict.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (kind) (rate(mqload_errors_total[30s]))",
          "legendFormat": "error {{kind}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(mqload_duplicates_total[30s]))",
          "legendFormat": "duplicates",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(mqload_unexpected_total[30s]))",
          "legendFormat": "unexpected",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(mqload_negative_acks_total[30s]))",
          "legendFormat": "negative acks",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(mqload_unexpected_acks_total[30s]))",
          "legendFormat": "unexpected acks",
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(mqload_pkid_gaps_total[30s]))",
          "legendFormat": "packet-id gaps",
          "refId": "F"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
