/target
# mqttui is a separate workspace (ADR 0056 §1), so it builds into its own target dir.
/tools/mqttui/target
**/target
# cargo-fuzz artifacts
**/fuzz/corpus
**/fuzz/artifacts
**/*.rs.bk
Cargo.lock.orig
.DS_Store
*.pem
*.key
*.crt

# Test-only PKI fixtures (not real secrets) must be committed despite *.pem
!crates/mqtt-auth/src/testdata/
!crates/mqtt-auth/src/testdata/*.pem

# Python bytecode cache (scripts/)
__pycache__/
*.pyc

# Release binary staging area for the container image build (ADR 0045)
dist/

# Linux binaries staged for the operator e2e images (scripts/k8s/operator-e2e.sh
# removes them on a clean run; an aborted run leaves them behind)
dist-e2e-mqttd
dist-e2e-operator
