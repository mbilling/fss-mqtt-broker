    {
      "type": "timeseries",
      "title": "Forwarded /s by upstream and direction \u2014 1 minute window",
      "description": "`out` is local\u2192upstream, `in` is upstream\u2192local. A one-way rule shows traffic in one direction only \u2014 if you see both for a rule you meant to be unidirectional, the policy is not what you think it is.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
