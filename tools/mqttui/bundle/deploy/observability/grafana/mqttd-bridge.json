    {
      "type": "timeseries",
      "title": "Spool depth per side",
      "description": "Messages queued for a side that is down or behind. This is the bridge's durability buffer: it fills while a side is unreachable and drains on reconnect.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "fss_bridge_spool_depth{instance=~\"$instance\"}",
