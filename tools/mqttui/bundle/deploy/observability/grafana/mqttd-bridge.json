          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * fss_bridge_spool_depth{instance=~\"$instance\"} / fss_bridge_spool_capacity{instance=~\"$instance\"}",
