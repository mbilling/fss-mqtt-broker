      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(fss_bridge_forwarded_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "1m"
