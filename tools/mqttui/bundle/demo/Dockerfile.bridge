# syntax=docker/dockerfile:1
# Build the mqtt-bridge boundary bridge binary (ADR 0025), then ship it on a slim runtime.
# Build context is the repo root (see docker-compose.yml `build.context: ..`).
# Base images are digest-pinned (OpenSSF Pinned-Dependencies); Dependabot's docker
# ecosystem entry for /demo proposes the digest bumps.
FROM rust:1-bookworm@sha256:114c7a4425406451c2866b6aafe69fe29b1b298832db1277d411ac73c82d04d6 AS builder
WORKDIR /src
COPY . .
RUN cargo build --release --bin mqtt-bridge

FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /src/target/release/mqtt-bridge /usr/local/bin/mqtt-bridge
# Bridge metrics (8090) — Prometheus text, scraped like the brokers.
EXPOSE 8090
ENTRYPOINT ["mqtt-bridge"]
CMD ["/etc/bridge/bridge.toml"]
