   "id": 20,
   "type": "timeseries",
   "title": "QUIC connection migrations /min (by node)",
   "description": "Client path changes (Wi-Fi\u2194cellular, NAT rebind) QUIC carried on the same connection \u2014 same session, no reconnect (ADR 0036 \u00a73b).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 60
