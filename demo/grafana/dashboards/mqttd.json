{
 "uid": "mqttd-overview",
 "title": "mqttd \u2014 broker overview",
 "tags": [
  "mqttd",
  "mqtt",
  "cluster"
 ],
 "timezone": "",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "annotations": {
  "list": [
   {
    "name": "cluster reformation",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "hide": false,
    "iconColor": "orange",
    "expr": "max(changes(mqttd_lease_epoch[1m])) > 0",
    "titleFormat": "cluster re-formed",
    "textFormat": "lease re-election (epoch changed) \u2014 on this single-host demo usually a host stall breaking the 3s leader lease; see the README's fsync-bound caveat"
   }
  ]
 },
 "templating": {
  "list": [
   {
    "name": "instance",
    "label": "Node",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(mqttd_connections_active, instance)",
     "refId": "A"
    },
    "includeAll": true,
    "multi": true,
    "refresh": 2,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Cluster members",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(mqttd_cluster_members)"
    }
   ]
  },
